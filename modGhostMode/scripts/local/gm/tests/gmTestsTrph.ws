// TRPH's in-game checks (trophies, docs/features/trph.md). gmtest_regress() and gmtest_panel() call the two
// functions GMTest_trph() and GMTest_trph_after(), so TRPH adds its checks here and never edits gmTests.ws's lists.
//   GMTest_trph()        in gmtest_regress(): checks that need no fight, input or menu, each restoring what it changes
//   GMTest_trph_after()  in gmtest_panel(): checks that need the pause menu open, or read the game a frame or more
//                        after gmtest_regress() (spawned samples, effects' first updates)
// The data tables (GMTestTrphData, GMTestTrphItems) are generated by tools/gen_trph.py (gmTestsTrphData.ws).
// Outside the regression (scripted hits, kills, tooltips): gmtest_trph_spawn(), then gmtest_trph_fight() in a later call;
// gmtest_trph_toxtip() (the Arachas trophy's tooltip with Expert Brewer).

exec function gmtest_trph()
{
	thePlayer.GMTestCount(true, true);
	GMTest_trph();
	LogChannel('GMTest', "SUMMARY trph: " + thePlayer.gmTestPassed + " passed, " + thePlayer.gmTestFailed + " failed");
}

function GMTest_trph()
{
	GMTestTrphData();
	GMTestTrphAll();
	GMTestTrphGold('mh305_doppler_trophy', 25, "TRPH-01 Doppler trophy");
	GMTestTrphGold('q602_pig_contest_trophy', 35, "TRPH-03 King of Swineherd's crown");
	GMTestTrphGold('q603_sharley_trophy', 50, "TRPH-03 Conserved shaelmaar trophy");
	GMTestTrphHerbs('mq7002_spriggan_trophy', "TRPH-02 Grottore trophy");
	GMTestTrphHerbs('mq7017_zmora_trophy', "TRPH-02 Umbra trophy");
	GMTestTrphSeal();
	GMTestTrphToxTip("");
	GMTestTrphWightLimit();
	GMTestTrphMerge();
}

function GMTest_trph_after()
{
}

// One node of a trophy ability as the definitions give it: typ "base", "mult" or "add" (that part must be
// `value`), or "zero" (a 1.32 bonus node legacy dropped: every part 0).
function GMTestTrphNode(abl : name, attr : name, typ : string, value : float)
{
	var min, max : SAbilityAttributeValue;
	var v : float;
	var ok : bool;

	theGame.GetDefinitionsManager().GetAbilityAttributeValue(abl, attr, min, max);
	if(typ == "zero")
		ok = min.valueBase == 0 && min.valueMultiplicative == 0 && min.valueAdditive == 0;
	else
	{
		if(typ == "base")
			v = min.valueBase;
		else if(typ == "mult")
			v = min.valueMultiplicative;
		else
			v = min.valueAdditive;
		ok = AbsF(v - value) < 0.0001;
	}
	GMTestReport(ok, "TRPH data " + abl + "." + attr + " " + typ + " " + NoTrailZeros(value) + ": base " + min.valueBase
		+ ", mult " + min.valueMultiplicative + ", add " + min.valueAdditive);
}

// A Swallow's duration from its definition, for the Water hag trophy (CalculatePotionDuration scales it).
function GMTestTrphPotionRaw() : float
{
	var min, max : SAbilityAttributeValue;

	theGame.GetDefinitionsManager().GetItemAttributeValueNoRandom('Swallow 1', true, 'duration', min, max);
	return CalculateAttributeValue(min);
}

// A trophy bonus on Geralt as the game's own readers see it: resistances through GetResistValue (what the damage
// and effect code reads), maximum Vitality and toxicity, attack power and each sign's intensity through the
// power-stat functions, potion duration through CalculatePotionDuration (what drinking a potion computes),
// everything else through GetAttributeValue (the damage formula's armor piercing, the crit code, the regen
// effects, CheckForBonusMoney), the part the node's type sets.
function GMTestTrphRead(attr : name, typ : string) : float
{
	var w : W3PlayerWitcher;
	var v : SAbilityAttributeValue;
	var pts, perc : float;
	var res : ECharacterDefenseStats;
	var isPoint, horseBonus : bool;

	w = GetWitcherPlayer();
	res = ResistStatNameToEnum(attr, isPoint);
	if(res != CDS_None && !isPoint)
	{
		w.GetResistValue(res, pts, perc);
		return perc;
	}
	switch(attr)
	{
		case 'vitality':
			return w.GetStatMax(BCS_Vitality);
		case 'toxicity':
			return w.GetStatMax(BCS_Toxicity);
		case 'encumbrance':
			return w.GetMaxRunEncumbrance(horseBonus);	// the carry limit the inventory and the overburdened rule read
		case 'potion_duration':
			return w.CalculatePotionDuration(GetInvalidUniqueId(), false, 'Swallow 1');
		case 'attack_power':
			v = w.GetPowerStatValue(CPS_AttackPower);
			return v.valueMultiplicative;
		case 'spell_power':
		case 'spell_power_aard':
			v = w.GetTotalSignSpellPower(S_Magic_1);
			return v.valueMultiplicative;
		case 'spell_power_igni':
			v = w.GetTotalSignSpellPower(S_Magic_2);
			return v.valueMultiplicative;
		case 'spell_power_yrden':
			v = w.GetTotalSignSpellPower(S_Magic_3);
			return v.valueMultiplicative;
		case 'spell_power_quen':
			v = w.GetTotalSignSpellPower(S_Magic_4);
			return v.valueMultiplicative;
		case 'spell_power_axii':
			v = w.GetTotalSignSpellPower(S_Magic_5);
			return v.valueMultiplicative;
	}
	v = w.GetAttributeValue(attr);
	if(typ == "base")
		return v.valueBase;
	if(typ == "mult")
		return v.valueMultiplicative;
	return v.valueAdditive;
}

// The 1.32 bonuses legacy's trophies dropped (experience from kills, dismemberment, herbs, gold), as Geralt has them.
function GMTestTrphOld() : array<float>
{
	var w : W3PlayerWitcher;
	var vals : array<float>;
	var i : int;

	w = GetWitcherPlayer();
	for(i = 0; i < 5; i += 1)
		vals.PushBack(CalculateAttributeValue(w.GetAttributeValue(GMTestTrphOldName(i))));
	return vals;
}

function GMTestTrphOldName(i : int) : name
{
	switch(i)
	{
		case 0: return 'human_exp_bonus_when_fatal';
		case 1: return 'nonhuman_exp_bonus_when_fatal';
		case 2: return 'dismember_chance_mult';
		case 3: return 'bonus_herb_chance';
	}
	return 'bonus_money';
}

// Puts a new copy of `item` on Roach through the horse manager, as the inventory's horse slot does: moved to the
// horse's inventory, then EquipItem. Returns its id in the horse's inventory.
function GMTestTrphPutOn(item : name) : SItemUniqueId
{
	var w : W3PlayerWitcher;
	var hm : W3HorseManager;
	var ids : array<SItemUniqueId>;
	var hid : SItemUniqueId;

	w = GetWitcherPlayer();
	hm = w.GetHorseManager();
	ids = w.inv.AddAnItem(item, 1);
	hid = hm.MoveItemToHorse(ids[0], 1);
	hm.EquipItem(hid);
	return hid;
}

// Takes the trophy off Roach (UnequipItem gives it back to Geralt) and removes it.
function GMTestTrphTakeOff()
{
	var w : W3PlayerWitcher;
	var pid : SItemUniqueId;

	w = GetWitcherPlayer();
	pid = w.GetHorseManager().UnequipItem(EES_HorseTrophy);
	if(w.inv.IsIdValid(pid))
		w.inv.RemoveItem(pid, 1);
}

// TRPH-01 to TRPH-03: a trophy on Roach gives Geralt its bonus, read before, with it on Roach and after it is taken
// off; the 1.32 bonuses it no longer gives stay as they were.
function GMTestTrphEquip(item : name, abl : name, attr : name, typ : string, value : float)
{
	var w : W3PlayerWitcher;
	var hm : W3HorseManager;
	var before, with, after, want : float;
	var old0, old1 : array<float>;
	var i : int;
	var on, has, gone, oldOk : bool;
	var oldText : string;

	w = GetWitcherPlayer();
	hm = w.GetHorseManager();
	want = value;
	if(attr == 'potion_duration')
		want = value * GMTestTrphPotionRaw();
	// The carry limit (GetMaxRunEncumbrance) counts the Wight trophy's +20 once (trph/carryLimit.ws; 1.32's, legacy's
	// and 5.x's code counted it on Geralt and on the horse: +40)
	before = GMTestTrphRead(attr, typ);
	old0 = GMTestTrphOld();
	GMTestTrphPutOn(item);
	on = hm.IsItemEquippedByName(item);
	has = w.HasAbility(abl);
	with = GMTestTrphRead(attr, typ);
	old1 = GMTestTrphOld();
	oldOk = true;
	for(i = 0; i < old0.Size(); i += 1)
	{
		if(GMTestTrphOldName(i) != attr && AbsF(old1[i] - old0[i]) > 0.0001)
		{
			oldOk = false;
			oldText += " " + GMTestTrphOldName(i) + " " + old0[i] + " -> " + old1[i];
		}
	}
	GMTestTrphTakeOff();
	gone = !w.HasAbility(abl) && !hm.IsItemEquippedByName(item);
	after = GMTestTrphRead(attr, typ);
	if(oldOk)
		oldText = ", no 1.32 bonus";
	else
		oldText = "; 1.32 bonus:" + oldText;
	GMTestReport(on && has && AbsF(with - before - want) < 0.001 && AbsF(after - before) < 0.001 && gone && oldOk,
		"TRPH " + item + " on Roach: " + attr + " " + before + " -> " + with + " (want +" + want + "), off " + after
		+ "; on " + on + ", " + abl + " " + has + ", gone after " + gone + oldText);
}

// Every trophy, one at a time; the trophy Roach carries (if any) taken off first and put back after, and the
// horse mode kept (EquipItem without a spawned horse resets it).
function GMTestTrphAll()
{
	var w : W3PlayerWitcher;
	var hm : W3HorseManager;
	var prev, pid, hid : SItemUniqueId;
	var prevName : name;
	var mode : EHorseMode;

	w = GetWitcherPlayer();
	hm = w.GetHorseManager();
	mode = hm.GetHorseMode();
	prev = hm.GetItemInSlot(EES_HorseTrophy);
	if(hm.GetInventoryComponent().IsIdValid(prev))
	{
		prevName = hm.GetInventoryComponent().GetItemName(prev);
		pid = hm.UnequipItem(EES_HorseTrophy);
	}
	GMTestTrphItems();
	if(IsNameValid(prevName))
	{
		hid = hm.MoveItemToHorse(pid, 1);
		hm.EquipItem(hid);
	}
	if(hm.GetHorseMode() != mode)
		hm.SetHorseMode(mode);
	GMTestReport((!IsNameValid(prevName) || hm.IsItemEquippedByName(prevName)) && hm.GetHorseMode() == mode,
		"TRPH Roach's own trophy back (" + prevName + "), horse mode " + hm.GetHorseMode());
}

@addMethod(W3Container)
function GMTestBonusMoney()
{
	CheckForBonusMoney(0);
}

// A gold trophy's bonus in a container: 100 crowns become 100 + pct when Geralt first comes in range
// (CheckForBonusMoney, the code OnInteractionActivated runs), plus any bonus gold Geralt has from elsewhere.
function GMTestTrphGold(item : name, pct : int, label : string)
{
	var template : CEntityTemplate;
	var c : W3Container;
	var w : W3PlayerWitcher;
	var base, got, want : int;

	w = GetWitcherPlayer();
	template = (CEntityTemplate)LoadResource("gameplay\containers\container_template.w2ent", true);
	c = (W3Container)theGame.CreateEntity(template, w.GetWorldPosition() + w.GetHeadingVector() * 3, w.GetWorldRotation());
	if(!c)
	{
		GMTestReport(false, label + "'s gold: no container spawned");
		return;
	}
	c.GetInventory().RemoveAllItems();
	c.GetInventory().AddMoney(100);
	c.GMTestBonusMoney();
	base = c.GetInventory().GetMoney();
	c.GetInventory().RemoveMoney(c.GetInventory().GetMoney());
	GMTestTrphPutOn(item);
	c.GetInventory().AddMoney(100);
	c.GMTestBonusMoney();
	got = c.GetInventory().GetMoney();
	GMTestTrphTakeOff();
	want = base + pct;
	GMTestReport(got == want, label + " on Roach: 100 crowns in a container become " + got + " (want " + want + "; without it " + base + ")");
	c.Destroy();
}

@addMethod(W3RefillableContainer)
function GMTestBonusHerbs(chance : float)
{
	var noItems : array<SItemUniqueId>;
	var noCounts : array<int>;

	CheckForBonusHerbs(noItems, noCounts, chance);
}

// TRPH-02: a herb trophy's +100% herbs: a herb plant gives one more of each herb when Geralt comes in range
// (OnInteractionActivated: CheckForBonusHerbs with Geralt's bonus_herb_chance, each herb kind rolled once).
function GMTestTrphHerbs(item : name, label : string)
{
	var template : CEntityTemplate;
	var c : W3RefillableContainer;
	var w : W3PlayerWitcher;
	var chance : float;
	var got : int;

	w = GetWitcherPlayer();
	template = (CEntityTemplate)LoadResource("gameplay\containers\herbs\celandine.w2ent", true);
	c = (W3RefillableContainer)theGame.CreateEntity(template, w.GetWorldPosition() + w.GetHeadingVector() * 3, w.GetWorldRotation());
	if(!c)
	{
		GMTestReport(false, label + ": no herb plant spawned");
		return;
	}
	c.GetInventory().RemoveAllItems();
	c.GetInventory().AddAnItem('Celandine', 2);
	GMTestTrphPutOn(item);
	chance = CalculateAttributeValue(w.GetAttributeValue('bonus_herb_chance'));
	c.GMTestBonusHerbs(chance);
	got = c.GetInventory().GetItemQuantityByName('Celandine');
	GMTestTrphTakeOff();
	GMTestReport(chance >= 1 && got == 3, label + " on Roach: herb chance " + chance + ", a plant with 2 Celandine gives " + got + " (want 3)");
	c.Destroy();
}

// TRPH-02: the Camerlengo's Seal is no longer a quest item: its tags lack Quest, so the shop's sale check and the
// inventory's drop check (guiPlayerInventoryComponent: price above 0 and no Quest tag) let it go.
function GMTestTrphSeal()
{
	var w : W3PlayerWitcher;
	var ids : array<SItemUniqueId>;
	var tags : array<name>;
	var price, i : int;
	var isQuest, trophy, sale, drop : bool;
	var text : string;

	w = GetWitcherPlayer();
	ids = w.inv.AddAnItem('camm_trophy', 1);
	isQuest = w.inv.ItemHasTag(ids[0], 'Quest');
	trophy = w.inv.ItemHasTag(ids[0], 'Trophy');
	price = w.inv.GetItemPrice(ids[0]);
	w.inv.GetItemTags(ids[0], tags);
	for(i = 0; i < tags.Size(); i += 1)
		text += " " + tags[i];
	sale = price > 0 && !isQuest;
	drop = !w.inv.ItemHasTag(ids[0], 'NoDrop') && !isQuest;
	w.inv.RemoveItem(ids[0], 1);
	GMTestReport(!isQuest && trophy && sale && drop && price == 250, "TRPH-02 Camerlengo's Seal: tags" + text + " (no Quest), price " + price
		+ " (want 250), sellable " + sale + ", droppable " + drop);
}

// TRPH-02: the Wight trophy's +20 counts once in the carry limit (the owner's decision on the TRPH audit, 2026-11-02),
// and the saddlebags, which work through the horse, are unchanged. Roach's own bag and trophy are taken off first and
// put back after; the limits are read from the game (GetMaxRunEncumbrance) next to Geralt's own capacity.
function GMTestTrphLimitWith(bag : name, trophy : name) : float
{
	var w : W3PlayerWitcher;
	var hm : W3HorseManager;
	var ids : array<SItemUniqueId>;
	var hb : bool;
	var limit : float;

	w = GetWitcherPlayer();
	hm = w.GetHorseManager();
	if(IsNameValid(bag))
	{
		ids = hm.GetInventoryComponent().AddAnItem(bag, 1, true, true);
		hm.EquipItem(ids[0]);
	}
	if(IsNameValid(trophy))
		GMTestTrphPutOn(trophy);
	limit = w.GetMaxRunEncumbrance(hb);
	if(IsNameValid(trophy))
		GMTestTrphTakeOff();
	if(IsNameValid(bag))
	{
		hm.UnequipItem(EES_HorseBag);
		hm.GetInventoryComponent().RemoveItemByName(bag, hm.GetInventoryComponent().GetItemQuantityByName(bag));
		w.inv.RemoveItemByName(bag, w.inv.GetItemQuantityByName(bag));
	}
	return limit;
}

function GMTestTrphWightLimit()
{
	var w : W3PlayerWitcher;
	var hm : W3HorseManager;
	var hinv : CInventoryComponent;
	var bagId, trophyId, pid, gid : SItemUniqueId;
	var bagName, trophyName : name;
	var mode : EHorseMode;
	var own, none, wight, b1, b2, b3, b1w : float;

	w = GetWitcherPlayer();
	hm = w.GetHorseManager();
	hinv = hm.GetInventoryComponent();
	mode = hm.GetHorseMode();
	bagId = hm.GetItemInSlot(EES_HorseBag);
	if(hinv.IsIdValid(bagId))
	{
		bagName = hinv.GetItemName(bagId);
		gid = hm.UnequipItem(EES_HorseBag);
	}
	trophyId = hm.GetItemInSlot(EES_HorseTrophy);
	if(hinv.IsIdValid(trophyId))
	{
		trophyName = hinv.GetItemName(trophyId);
		pid = hm.UnequipItem(EES_HorseTrophy);
	}
	own = CalculateAttributeValue(w.GetAttributeValue('encumbrance'));
	none = GMTestTrphLimitWith('', '');
	wight = GMTestTrphLimitWith('', 'q702_wicht_trophy');
	b1 = GMTestTrphLimitWith('Horse Bag 1', '');
	b2 = GMTestTrphLimitWith('Horse Bag 2', '');
	b3 = GMTestTrphLimitWith('Horse Bag 3', '');
	b1w = GMTestTrphLimitWith('Horse Bag 1', 'q702_wicht_trophy');
	GMTestReport(AbsF(none - own) < 0.001 && AbsF(wight - own - 20) < 0.001, "TRPH-02 Wight trophy: carry limit " + none + " -> " + wight + " (want +20, once; Geralt's own capacity " + own + ")");
	GMTestReport(AbsF(b1 - own - 40) < 0.001 && AbsF(b2 - own - 60) < 0.001 && AbsF(b3 - own - 80) < 0.001 && AbsF(b1w - own - 60) < 0.001,
		"TRPH-02 saddlebags unchanged by it: " + b1 + ", " + b2 + ", " + b3 + " (want " + (own + 40) + ", " + (own + 60) + ", " + (own + 80) + "); bag 1 with the Wight trophy " + b1w + " (want " + (own + 60) + ")");
	// Roach's own bag and trophy back (the unequips gave them to Geralt)
	if(IsNameValid(bagName) && w.inv.IsIdValid(gid))
		hm.EquipItem(hm.MoveItemToHorse(gid, 1));
	if(IsNameValid(trophyName) && w.inv.IsIdValid(pid))
		hm.EquipItem(hm.MoveItemToHorse(pid, 1));
	if(hm.GetHorseMode() != mode)
		hm.SetHorseMode(mode);
	w.UpdateEncumbrance();
	GMTestReport((!IsNameValid(bagName) || hm.IsItemEquippedByName(bagName)) && (!IsNameValid(trophyName) || hm.IsItemEquippedByName(trophyName)),
		"TRPH-02 Wight check: Roach's own bag (" + bagName + ") and trophy (" + trophyName + ") back");
}

exec function gmtest_trph_wight()
{
	thePlayer.GMTestCount(true, true);
	GMTestTrphWightLimit();
	LogChannel('GMTest', "SUMMARY trph wight: " + thePlayer.gmTestPassed + " passed, " + thePlayer.gmTestFailed + " failed");
}

// ---- TRPH audit F3: bonus gold on every corpse 5.x's loot merge takes (trph/bonusGold.ws) ----
// Three remains holding 100 crowns each at 2, 6 and 12 m in front of Geralt, the Doppler trophy (+25%) on Roach; one
// merged loot of the 2 m remains takes all three: 375 crowns (5.x: 325 once Geralt has stood by the 2 m remains,
// 300 before). Other remains within 20 m are tagged 'lootbag' for the test (the merge skips loot bags) and untagged
// afterwards, so only the test's remains count.
@addField(CR4Player)
var gmTestTrphShielded : array<CGameplayEntity>;

@addField(CR4Player)
var gmTestTrphOldMerge : string;

@addField(CR4Player)
var gmTestTrphMergeM0 : int;

@addField(CR4Player)
var gmTestTrphMergeWant : int;

function GMTestTrphMergeTag(d : int) : name
{
	if(d == 0) return 'gmtest_trph_merge0';
	if(d == 1) return 'gmtest_trph_merge1';
	return 'gmtest_trph_merge2';
}

function GMTestTrphMergeDist(d : int) : float
{
	if(d == 0) return 2;
	if(d == 1) return 6;
	return 12;
}

function GMTestTrphMergeSpawn()
{
	var w : W3PlayerWitcher;
	var template : CEntityTemplate;
	var c : W3ActorRemains;
	var d : int;

	w = GetWitcherPlayer();
	GMTestTrphPutOn('mh305_doppler_trophy');
	template = (CEntityTemplate)LoadResource("items\remains\remains__monster_01\remains__monster_01.w2ent", true);
	for(d = 0; d < 3; d += 1)
	{
		c = (W3ActorRemains)theGame.CreateEntity(template, w.GetWorldPosition() + w.GetHeadingVector() * GMTestTrphMergeDist(d), w.GetWorldRotation());
		if(c)
		{
			c.GetInventory().RemoveAllItems();
			c.GetInventory().AddMoney(100);
			c.AddTag(GMTestTrphMergeTag(d));
		}
	}
}

// Tags the other remains near the root 'lootbag', so the merge leaves them.
function GMTestTrphMergeShield(root : CGameplayEntity)
{
	var found : array<CGameplayEntity>;
	var i : int;

	thePlayer.gmTestTrphShielded.Clear();
	FindGameplayEntitiesInRange(found, root, 20.0f, 100, '', 0, NULL, 'W3ActorRemains');
	for(i = 0; i < found.Size(); i += 1)
	{
		if(!found[i] || found[i].HasTag('lootbag') || found[i].HasTag('gmtest_trph_merge0') || found[i].HasTag('gmtest_trph_merge1') || found[i].HasTag('gmtest_trph_merge2'))
			continue;
		found[i].AddTag('lootbag');
		thePlayer.gmTestTrphShielded.PushBack(found[i]);
	}
}

function GMTestTrphMergeUnshield()
{
	var i : int;

	for(i = 0; i < thePlayer.gmTestTrphShielded.Size(); i += 1)
		if(thePlayer.gmTestTrphShielded[i])
			thePlayer.gmTestTrphShielded[i].RemoveTag('lootbag');
	thePlayer.gmTestTrphShielded.Clear();
}

// What the three remains are worth to Geralt with his bonus gold now (CheckForBonusMoney's rounding).
function GMTestTrphMergeWant() : int
{
	return 3 * (100 + RoundMath(100 * CalculateAttributeValue(thePlayer.GetAttributeValue('bonus_money'))));
}

// Reports Geralt's crowns gained against the want, then removes them, the remains and the trophy.
function GMTestTrphMergeEnd(gain : int, want : int, how : string)
{
	var c : CEntity;
	var d, left : int;

	for(d = 0; d < 3; d += 1)
	{
		c = theGame.GetEntityByTag(GMTestTrphMergeTag(d));
		if(c)
		{
			left += ((W3Container)c).GetInventory().GetMoney();
			c.Destroy();
		}
	}
	GMTestTrphMergeUnshield();
	GMTestReport(gain == want && left == 0, "TRPH audit F3 loot merge (" + how + "): three remains with 100 crowns at 2, 6 and 12 m, Doppler trophy on Roach: Geralt gains "
		+ gain + " (want " + want + "; 5.x: the bonus only on remains Geralt approached), " + left + " left behind");
	if(gain > 0)
		thePlayer.RemoveMoney(gain);
	GMTestTrphTakeOff();
}

// Auto-loot with the merge on, through W3Container.ProcessLoot, on the 2 m remains.
function GMTestTrphMergeAuto(how : string)
{
	var c : W3ActorRemains;
	var cfg : CInGameConfigWrapper;
	var oldAuto, oldMerge : string;
	var m0, want : int;

	c = (W3ActorRemains)theGame.GetEntityByTag(GMTestTrphMergeTag(0));
	if(!c || !theGame.GetEntityByTag(GMTestTrphMergeTag(1)) || !theGame.GetEntityByTag(GMTestTrphMergeTag(2)))
	{
		GMTestReport(false, "TRPH audit F3: the three remains were not spawned");
		GMTestTrphMergeEnd(0, 0, how);
		return;
	}
	want = GMTestTrphMergeWant();
	GMTestTrphMergeShield(c);
	cfg = theGame.GetInGameConfigWrapper();
	oldAuto = cfg.GetVarValue('Accessibility', 'AutoLoot');
	oldMerge = cfg.GetVarValue('Gameplay', 'LootMergeEnabled');
	cfg.SetVarValue('Accessibility', 'AutoLoot', "true");
	cfg.SetVarValue('Gameplay', 'LootMergeEnabled', "true");
	m0 = thePlayer.GetMoney();
	c.GMTestProcessLoot();
	cfg.SetVarValue('Accessibility', 'AutoLoot', oldAuto);
	cfg.SetVarValue('Gameplay', 'LootMergeEnabled', oldMerge);
	GMTestTrphMergeEnd(thePlayer.GetMoney() - m0, want, how);
}

// In the regression: spawned and looted in one call (none of the remains approached yet: 5.x gives 300).
function GMTestTrphMerge()
{
	GMTestTrphMergeSpawn();
	GMTestTrphMergeAuto("Auto-loot, in one call");
}

// In play, as the audit ran it: gmtest_trph_merge_spawn(), then in a later call (Geralt has stood by the 2 m remains,
// which got its bonus then) gmtest_trph_merge_auto() for Auto-loot, or gmtest_trph_merge_window() (the loot window
// with the merge on, opened on the 2 m remains) and then gmtest_trph_merge_take() (its "take all").
exec function gmtest_trph_merge_spawn()
{
	GMTestTrphMergeSpawn();
	LogChannel('GMTest', "INFO TRPH merge: three remains spawned, Doppler trophy on Roach " + thePlayer.HasAbility('doppler_trophy_stats'));
}

exec function gmtest_trph_merge_auto()
{
	thePlayer.GMTestCount(true, true);
	GMTestTrphMergeAuto("Auto-loot");
	LogChannel('GMTest', "SUMMARY trph merge: " + thePlayer.gmTestPassed + " passed, " + thePlayer.gmTestFailed + " failed");
}

exec function gmtest_trph_merge_window()
{
	var c : W3ActorRemains;
	var e : W3Container;
	var pl : CR4Player;
	var d : int;

	pl = thePlayer;
	for(d = 0; d < 3; d += 1)
	{
		e = (W3Container)theGame.GetEntityByTag(GMTestTrphMergeTag(d));
		if(e)
			LogChannel('GMTest', "INFO TRPH merge " + GMTestTrphMergeDist(d) + " m remains: " + e.GetInventory().GetMoney() + " crowns before the window");
	}
	c = (W3ActorRemains)theGame.GetEntityByTag(GMTestTrphMergeTag(0));
	pl.gmTestTrphMergeWant = GMTestTrphMergeWant();
	GMTestTrphMergeShield(c);
	pl.gmTestTrphOldMerge = theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'LootMergeEnabled');
	theGame.GetInGameConfigWrapper().SetVarValue('Gameplay', 'LootMergeEnabled', "true");
	pl.gmTestTrphMergeM0 = thePlayer.GetMoney();
	c.ShowLoot();
	LogChannel('GMTest', "INFO TRPH merge: the loot window requested on the 2 m remains (merge on)");
}

exec function gmtest_trph_merge_take()
{
	var popup : CR4LootPopup;

	thePlayer.GMTestCount(true, true);
	popup = (CR4LootPopup)theGame.GetGuiManager().GetPopup('LootPopup');
	if(popup)
		popup.OnPopupTakeAllItems();
	else
		GMTestReport(false, "TRPH audit F3: no loot window open");
	theGame.GetInGameConfigWrapper().SetVarValue('Gameplay', 'LootMergeEnabled', thePlayer.gmTestTrphOldMerge);
	GMTestTrphMergeEnd(thePlayer.GetMoney() - thePlayer.gmTestTrphMergeM0, thePlayer.gmTestTrphMergeWant, "the loot window");
	LogChannel('GMTest', "SUMMARY trph merge: " + thePlayer.gmTestPassed + " passed, " + thePlayer.gmTestFailed + " failed");
}

// ---- Outside the regression: scripted hits, kills and tooltips (gmtest_trph_spawn, then gmtest_trph_fight) ----

exec function gmtest_trph_spawn()
{
	var w : W3PlayerWitcher;
	var npc : CNewNPC;
	var i : int;

	w = GetWitcherPlayer();
	w.GMTestXpClear();
	thePlayer.GMTestDummyClearAll();
	GMTestDummySpawn("human");
	for(i = 0; i < 2; i += 1)
	{
		npc = GMTestAi06Spawn("characters\npc_entities\monsters\gryphon_lvl1.w2ent", 30 + 5 * i);
		w.GMTestXpAddNpc(npc, "trph griffin " + i);
	}
	LogChannel('GMTest', "INFO TRPH a test dummy and " + w.gmTestXpNpcs.Size() + " griffins spawned; gmtest_trph_fight() in a later call");
}

// Equips `s` (learned first if needed); returns whether it was equipped before.
function GMTestTrphSkill(s : ESkill) : bool
{
	var w : W3PlayerWitcher;
	var eq : bool;

	w = GetWitcherPlayer();
	eq = w.IsSkillEquipped(s);
	if(!w.HasLearnedSkill(s))
		w.AddSkill(s);
	if(!eq)
		w.EquipSkill(s, w.GetFreeSkillSlot());
	return eq;
}

// A trophy's tooltip rows as the inventory builds them: the row of `attr` and its value.
function GMTestTrphTooltip(tc : W3TooltipComponent, item : name, attr : string, want : string)
{
	var w : W3PlayerWitcher;
	var data, line : CScriptedFlashObject;
	var list : CScriptedFlashArray;
	var ids : array<SItemUniqueId>;
	var i : int;
	var rows, value : string;

	w = GetWitcherPlayer();
	ids = w.inv.AddAnItem(item, 1);
	data = tc.GetBaseItemData(ids[0], w.inv);
	list = data.GetMemberFlashArray("StatsList");
	for(i = 0; i < list.GetLength(); i += 1)
	{
		line = list.GetElementFlashObject(i);
		rows += " [" + line.GetMemberFlashString("id") + ": " + line.GetMemberFlashString("name") + " " + line.GetMemberFlashString("value") + "]";
		if(line.GetMemberFlashString("id") == attr)
			value = line.GetMemberFlashString("value");
	}
	w.inv.RemoveItem(ids[0], 1);
	GMTestReport(value != "" && StrFindFirst(value, want) >= 0, "TRPH tooltip " + item + ": " + attr + " '" + value + "' (want " + want + "); rows:" + rows);
}

// TRPH audit F2 (UI-06, legacy's AddItemStats flag): the Arachas trophy's toxicity row is gear's, "Maximum Toxicity
// +40", not a potion's "Toxicity 40" (39 with Expert Brewer, which only cuts potions).
function GMTestTrphToxTip(label : string)
{
	var w : W3PlayerWitcher;
	var tc : W3TooltipComponent;
	var data, line : CScriptedFlashObject;
	var list : CScriptedFlashArray;
	var ids : array<SItemUniqueId>;
	var i : int;
	var rowName, value, want : string;

	w = GetWitcherPlayer();
	tc = new W3TooltipComponent in w;
	tc.initialize(w.inv, theGame.GetHud().GetHudFlashValueStorage());
	tc.setCurrentInventory(w.inv);
	ids = w.inv.AddAnItem('mh102_arachas_trophy', 1);
	data = tc.GetBaseItemData(ids[0], w.inv);
	list = data.GetMemberFlashArray("StatsList");
	for(i = 0; i < list.GetLength(); i += 1)
	{
		line = list.GetElementFlashObject(i);
		if(line.GetMemberFlashString("id") == "toxicity")
		{
			rowName = line.GetMemberFlashString("name");
			value = line.GetMemberFlashString("value");
		}
	}
	w.inv.RemoveItem(ids[0], 1);
	want = GetLocStringByKeyExt("panel_common_statistics_tooltip_current_maximum");
	GMTestReport(rowName == want && value == "+40", "TRPH-01 Arachas trophy's tooltip" + label + ": toxicity row '" + rowName + " " + value + "' (want '" + want + " +40')");
}

// The Arachas trophy's toxicity row as above, then with Expert Brewer equipped (outside the regression: it learns
// and equips the skill, and unequips it afterwards).
exec function gmtest_trph_toxtip()
{
	var w : W3PlayerWitcher;
	var had : bool;

	w = GetWitcherPlayer();
	thePlayer.GMTestCount(true, true);
	GMTestTrphToxTip("");
	had = GMTestTrphSkill(S_Alchemy_s03);
	GMTestTrphToxTip(", Expert Brewer level " + w.GetSkillLevel(S_Alchemy_s03) + " (usable " + w.CanUseSkill(S_Alchemy_s03) + ", reduction "
		+ CalculateAttributeValue(w.GetSkillAttributeValue(S_Alchemy_s03, 'toxicityReduction', false, false)) + ")");
	if(!had && w.IsSkillEquipped(S_Alchemy_s03))
		w.UnequipSkill(w.GetSkillSlotID(S_Alchemy_s03));
	LogChannel('GMTest', "SUMMARY trph toxtip: " + thePlayer.gmTestPassed + " passed, " + thePlayer.gmTestFailed + " failed");
}

// The adrenaline a damaging hit gives (SKL-07's 0.1 x (1 + adrenaline gain)), without and with the Grave hag trophy.
function GMTestTrphAdrenaline(npc : CActor, label : string)
{
	var w : W3PlayerWitcher;
	var fg, a0, a1 : float;

	w = GetWitcherPlayer();
	a0 = GMTestSkl07Hit(npc, false, false);
	GMTestTrphPutOn('mh106_gravehag_trophy');
	fg = CalculateAttributeValue(w.GetAttributeValue('focus_gain'));
	if(w.CanUseSkill(S_Sword_s20))
		fg += CalculateAttributeValue(w.GetSkillAttributeValue(S_Sword_s20, 'focus_gain', false, true)) * w.GetSkillLevel(S_Sword_s20);
	a1 = GMTestSkl07Hit(npc, false, false);
	GMTestTrphTakeOff();
	GMTestReport(AbsF(a1 - a0 - 0.01) < 0.0001 && AbsF(a1 - 0.1 * (1 + fg)) < 0.0001,
		"TRPH-01 Grave hag trophy, " + label + ": a hit gives " + a1 + " adrenaline (without it " + a0 + "; want +0.01, 0.1 x (1 + " + fg + "))");
}

exec function gmtest_trph_fight()
{
	var w : W3PlayerWitcher;
	var npc : CNewNPC;
	var tc : W3TooltipComponent;
	var p, k0 : int;
	var hadRazor, hadProlonged : bool;

	w = GetWitcherPlayer();
	thePlayer.GMTestCount(true, true);
	if(GMIsNewTreeProfileInForce())
		LogChannel('GMTest', "INFO TRPH tree: new");
	else
		LogChannel('GMTest', "INFO TRPH tree: classic");
	npc = GMTestDummy();
	if(!npc)
		GMTestReport(false, "TRPH needs gmtest_trph_spawn() first");
	else
	{
		GMTestDummyNeutral(npc);
		w.SetImmortalityMode(AIM_Immortal, AIC_Default, true);
		// DT1: the Grave hag trophy's +10% adrenaline gain, alone and with Razor Focus (S_Sword_s20, both trees)
		GMTestTrphAdrenaline(npc, "no Razor Focus " + w.CanUseSkill(S_Sword_s20));
		hadRazor = GMTestTrphSkill(S_Sword_s20);
		GMTestTrphAdrenaline(npc, "Razor Focus level " + w.GetSkillLevel(S_Sword_s20) + " (" + w.CanUseSkill(S_Sword_s20) + ")");
		w.ForceSetStat(BCS_Focus, 0);
		w.SetImmortalityMode(AIM_None, AIC_Default, true);
	}
	// every trophy again with Razor Focus equipped, then with Prolonged Effects (one at a time: the test save has one
	// free skill slot), so the adrenaline gain and potion duration bonuses are summed with the skills'
	LogChannel('GMTest', "INFO TRPH skills: Razor Focus " + w.CanUseSkill(S_Sword_s20));
	GMTestTrphAll();
	if(!hadRazor && w.IsSkillEquipped(S_Sword_s20))
		w.UnequipSkill(w.GetSkillSlotID(S_Sword_s20));
	hadProlonged = GMTestTrphSkill(S_Alchemy_s04);
	GMTestReport(w.CanUseSkill(S_Alchemy_s04), "TRPH Prolonged Effects equipped (level " + w.GetSkillLevel(S_Alchemy_s04) + ", bonus " + w.GMProlongedEffectsBonus() + ")");
	GMTestTrphAll();
	if(!hadProlonged && w.IsSkillEquipped(S_Alchemy_s04))
		w.UnequipSkill(w.GetSkillSlotID(S_Alchemy_s04));
	// XP-04: a monster trophy gives no experience. A griffin 3 levels above Geralt: 10 x 1.48 = 14.8, truncated to
	// 14; 1.32's Chort trophy (+5% from monsters) would make it 15 (14 x 1.05 = 14.7, rounded)
	p = w.GetLevel();
	k0 = w.GMGetKills(GMENT_GRYPHON);
	GMTestXp04Kill("trph griffin 0", p + 3, 0, 14, 14, (int)GMENT_GRYPHON, ", no trophy");
	GMTestTrphPutOn('mh107_czart_trophy');
	GMTestXp04Kill("trph griffin 1", p + 3, 0, 14, 14, (int)GMENT_GRYPHON, ", Chort trophy on Roach");
	GMTestTrphTakeOff();
	w.GMTestKillsAdd(GMENT_GRYPHON, k0 - w.GMGetKills(GMENT_GRYPHON));
	// UI-06's open check: a trophy's tooltip lists its bonus
	tc = new W3TooltipComponent in w;
	tc.initialize(w.inv, theGame.GetHud().GetHudFlashValueStorage());
	tc.setCurrentInventory(w.inv);
	GMTestTrphTooltip(tc, 'q002_griffin_trophy', "attack_power", "5");
	GMTestTrphTooltip(tc, 'mh104_ekimma_trophy', "critical_hit_chance", "10");
	GMTestTrphTooltip(tc, 'mh307_minion_trophy', "frost_resistance_perc", "50");
	GMTestTrphTooltip(tc, 'mh305_doppler_trophy', "bonus_money", "25");
	GMTestTrphTooltip(tc, 'mh201_cave_troll_trophy', "vitality", "500");
	w.GMTestXpClear();
	thePlayer.GMTestDummyClearAll();
	LogChannel('GMTest', "SUMMARY trph fight: " + thePlayer.gmTestPassed + " passed, " + thePlayer.gmTestFailed + " failed");
}

// ---- TRPH-04: no auto-equipping (gmtest_trph_loot) ----

// A monster's remains holding a trophy, spawned 2 m in front of Geralt.
function GMTestTrphRemains(item : name) : W3ActorRemains
{
	var template : CEntityTemplate;
	var c : W3ActorRemains;
	var w : W3PlayerWitcher;

	w = GetWitcherPlayer();
	template = (CEntityTemplate)LoadResource("items\remains\remains__monster_01\remains__monster_01.w2ent", true);
	c = (W3ActorRemains)theGame.CreateEntity(template, w.GetWorldPosition() + w.GetHeadingVector() * 2, w.GetWorldRotation());
	if(c)
	{
		c.GetInventory().RemoveAllItems();
		c.GetInventory().AddAnItem(item, 1);
	}
	return c;
}

// W3Container's ProcessLoot, which an animated container (the remains) reaches after its interaction animation
// (PlayInteractionAnimation: super.ProcessLoot()); its own ProcessLoot is empty.
@addMethod(W3AnimatedContainer)
function GMTestProcessLoot()
{
	super.ProcessLoot();
}

// One looting of a trophy from remains: `auto` through 5.x's "Auto-loot" path (ProcessLoot: TakeAllItems, then
// OnContainerClosed), else as the loot window does (TakeAllItems, then the window's close: OnContainerClosed,
// which calls FinalizeLooting).
function GMTestTrphLoot(item : name, auto : bool)
{
	var w : W3PlayerWitcher;
	var hm : W3HorseManager;
	var c : W3ActorRemains;
	var cfg : CInGameConfigWrapper;
	var had, have : int;
	var slot0, slot1 : SItemUniqueId;
	var n0, n1 : name;
	var oldAuto, how : string;

	w = GetWitcherPlayer();
	hm = w.GetHorseManager();
	slot0 = hm.GetItemInSlot(EES_HorseTrophy);
	if(hm.GetInventoryComponent().IsIdValid(slot0))
		n0 = hm.GetInventoryComponent().GetItemName(slot0);
	had = w.inv.GetItemQuantityByName(item);
	c = GMTestTrphRemains(item);
	if(!c)
	{
		GMTestReport(false, "TRPH-04 no remains spawned");
		return;
	}
	if(auto)
	{
		cfg = theGame.GetInGameConfigWrapper();
		oldAuto = cfg.GetVarValue('Accessibility', 'AutoLoot');
		cfg.SetVarValue('Accessibility', 'AutoLoot', "true");
		c.GMTestProcessLoot();
		cfg.SetVarValue('Accessibility', 'AutoLoot', oldAuto);
	}
	else
	{
		c.TakeAllItems();
		c.OnContainerClosed();
	}
	have = w.inv.GetItemQuantityByName(item);
	slot1 = hm.GetItemInSlot(EES_HorseTrophy);
	if(hm.GetInventoryComponent().IsIdValid(slot1))
		n1 = hm.GetInventoryComponent().GetItemName(slot1);
	if(auto)
		how = "Auto-loot";
	else
		how = "loot window";
	GMTestReport(have == had + 1 && n1 == n0 && !w.HasAbility('doppler_trophy_stats'),
		"TRPH-04 " + item + " looted (" + how + "): in Geralt's inventory " + had + " -> " + have
		+ " (want +1); Roach's trophy " + n0 + " -> " + n1 + " (want unchanged)");
	if(have > had)
		w.inv.RemoveItemByName(item, have - had);
	if(n1 != n0)
		GMTestTrphTakeOff();
	if(c)
		c.Destroy();
}

exec function gmtest_trph_loot()
{
	thePlayer.GMTestCount(true, true);
	GMTestTrphLoot('mh305_doppler_trophy', false);
	GMTestTrphLoot('mh305_doppler_trophy', true);
	LogChannel('GMTest', "SUMMARY trph loot: " + thePlayer.gmTestPassed + " passed, " + thePlayer.gmTestFailed + " failed");
}
// ProcessMonsterHuntTrophyQuest cannot be run by script: the compiler refuses a call to a latent quest function outside
// a quest block ("can only be called from as ScriptQuestBlock"), also from a state's entry function. Open for play.
