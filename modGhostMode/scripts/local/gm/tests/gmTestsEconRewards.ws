function GMTestEconRewardsAll(out checks : array<int>, out sums : array<int>) : int
{
	var f : int;

	f += GMTestEconRewards1(checks, sums);
	f += GMTestEconRewards2(checks, sums);
	f += GMTestEconRewards3(checks, sums);
	f += GMTestEconRewards4(checks, sums);
	return f;
}

// The number of rewards and their gold by group (index 1 to 4), as written.
function GMTestEconRewardExpected(group : int, out count : int, out gold : int)
{
	if(group == 1) { count = 187; gold = 37175; }
	if(group == 2) { count = 1; gold = 300; }
	if(group == 3) { count = 3; gold = 7100; }
	if(group == 4) { count = 3; gold = 415; }
}
