// In-game tests for AI-A slice A2: AI-03 (monster stats), AI-04 (human armor, allies), AI-05 (NPC,
// monster and secondary weapons), MonsterMHBoss, DA5 (5.x's new enemies). See docs/features/ai.md.
//   gmtest_ai03()             the definitions (in the regression run): every ability AI gives, read as the
//                             port means it (gmTestsAiData.ws, generated by tools/gen_ai.py), and headline values
//   gmtest_ai03_spawn()       spawns frozen hostile enemies of several kinds, 5.x's new ones included, at
//                             Geralt's level; then, in a later call (bonuses come by timer):
//   gmtest_ai03_read()        each one's health against legacy's data and A1's formula, armor, resistances,
//                             attack power, weapon damage, shown level
//   gmtest_ai03_probe(i)      scripted hits both ways with the i-th spawned enemy (the damage probe)
//   gmtest_ai05_torch()       Hearts of Stone's NPC torch (AI-A audit F2): its damage in a bandit's hand and a
//                             scripted torch hit of the bandit's on Geralt (the damage probe)
//   gmtest_ai03_fight_a(i) / gmtest_ai03_fight_b()   a real attack of the i-th enemy on Geralt (unfrozen,
//                             Geralt immortal), read from the damage probe; gmtest_swd_hit_a/b for Geralt's

// One value of an ability's definition (the sums of its min values); logs a FAIL line when it differs.
function GMTestAiNode(abl : name, attr : name, base : float, mult : float, add : float, later : bool, out port : int, out laterN : int) : int
{
	var b, m, a : float;

	if(later)
		laterN += 1;
	else
		port += 1;
	GMTestAiAbl(abl, attr, b, m, a);
	if(AbsF(b - base) < 0.001 && AbsF(m - mult) < 0.0001 && AbsF(a - add) < 0.001)
		return 0;
	LogChannel('GMTest', "FAIL AI data " + abl + "." + attr + " reads " + NoTrailZeros(b) + "/" + NoTrailZeros(m) + "/" + NoTrailZeros(a)
		+ " (" + NoTrailZeros(base) + "/" + NoTrailZeros(mult) + "/" + NoTrailZeros(add) + (later ? "; 5.x's until its feature is ported" : "; legacy's") + ")");
	return 1;
}

exec function gmtest_ai03()
{
	thePlayer.GMTestCount(true, true);
	GMTest_ai03();
	LogChannel('GMTest', "SUMMARY ai03: " + thePlayer.gmTestPassed + " passed, " + thePlayer.gmTestFailed + " failed");
}

// AI-03, AI-04, AI-05, AI-17's MonsterMHBoss, DA5: legacy's abilities as the game reads them. 5.x: a wolf
// level +5, MonsterMHBoss 8,000 Essence, NPC armor 8 to 50, the NPC short sword 200 slashing, the arachas's
// claws 35 rending, Reinald's template 25 Vitality with 50% fire resistance, ConDefaultSilver 25 Essence.
function GMTest_ai03()
{
	var f, port, later : int;
	var dm : CDefinitionsManagerAccessor;

	dm = theGame.GetDefinitionsManager();
	f = GMTestAiDataAll(port, later);
	GMTestReport(f == 0 && port > 690 && later > 20, "AI-03/04/05, AI-08 data: " + GMTestAiDataAbilities() + " abilities, " + port
		+ " values the port changes from 5.x's, " + later + " hit-severity, experience and weight values still 5.x's (AI-12, XP, WGT); " + f + " differ");
	GMTestReport(GMTestAiAblIs('mon_wolf', 'level', 0, 0, 1) && GMTestAiAblIs('mon_wolf', 'vitality', 80, 0, 0) && GMTestAiAblIs('mon_wolf', 'frost_resistance_perc', 0.3, 0, 0),
		"AI-03 " + GMTestAiAblText('mon_wolf', 'level') + ", " + GMTestAiAblText('mon_wolf', 'vitality') + ", " + GMTestAiAblText('mon_wolf', 'frost_resistance_perc')
		+ " (level +1, 80 Vitality, 30% frost; 5.x +5, which showed wolves 4 levels too high)");
	GMTestReport(GMTestAiAblIs('mon_arachas_base', 'slashing_resistance_perc', 0.35, 0, 0) && GMTestAiAblIs('mon_arachas_base', 'force_resistance_perc', 0.8, 0, 0)
		&& GMTestAiAblIs('mon_him', 'essence', 1350, 0, 0),
		"AI-03 " + GMTestAiAblText('mon_arachas_base', 'slashing_resistance_perc') + ", " + GMTestAiAblText('mon_arachas_base', 'force_resistance_perc') + ", "
		+ GMTestAiAblText('mon_him', 'essence') + " (35%, 80%; Skellige's Hym and 5.x's red-plague creature 1,350 Essence, 5.x 10,000)");
	GMTestReport(GMTestAiAblIs('MonsterMHBoss', 'essence', 0, 0, 0) && GMTestAiAblIs('MonsterMHBoss', 'attack_power', 0, 0, 0) && dm.AbilityHasTag('MonsterMHBoss', 'InstantKillImmune'),
		"AI-17 " + GMTestAiAblText('MonsterMHBoss', 'essence') + ", " + GMTestAiAblText('MonsterMHBoss', 'attack_power') + ", InstantKillImmune " + dm.AbilityHasTag('MonsterMHBoss', 'InstantKillImmune')
		+ " (no health or attack power of its own: the contract monsters' own abilities have them; tagged instant-kill immune)");
	GMTestReport(GMTestAiAblIs('NPC Leather Armor', 'armor', 30, 0, 0) && GMTestAiAblIs('NPC Heavy Leather Armor', 'armor', 45, 0, 0)
		&& GMTestAiAblIs('NPC Chainmail Armor', 'armor', 60, 0, 0) && GMTestAiAblIs('NPC Partial Plate Armor', 'armor', 90, 0, 0)
		&& GMTestAiAblIs('NPC Full Plate Armor', 'armor', 120, 0, 0) && GMTestAiAblIs('NPC Full Plate Armor', 'will_resistance_perc', 0, 0, 0.2),
		"AI-04 NPC armor " + GMTestAiAblText('NPC Leather Armor', 'armor') + ", " + GMTestAiAblText('NPC Chainmail Armor', 'armor') + ", "
		+ GMTestAiAblText('NPC Full Plate Armor', 'armor') + ", " + GMTestAiAblText('NPC Full Plate Armor', 'will_resistance_perc') + " (30/45/60/90/120, plate +20% will; 5.x 8 to 50)");
	GMTestReport(GMTestAiAblIs('NPC Short sword 1 _Stats', 'SlashingDamage', 300, 0, 0) && GMTestAiAblIs('mon_arachas_weapon _Stats', 'RendingDamage', 450, 0, 0)
		&& GMTestAiAblIs('mon_golem_weapon _Stats', 'BludgeoningDamage', 600, 0, 0) && GMTestAiAblIs('mon_nekker_weapon _Stats', 'RendingDamage', 300, 0, 0),
		"AI-05 " + GMTestAiAblText('NPC Short sword 1 _Stats', 'SlashingDamage') + ", " + GMTestAiAblText('mon_arachas_weapon _Stats', 'RendingDamage') + ", "
		+ GMTestAiAblText('mon_golem_weapon _Stats', 'BludgeoningDamage') + ", " + GMTestAiAblText('mon_nekker_weapon _Stats', 'RendingDamage') + " (300, 450, 600, 300)");
	GMTestReport(GMTestAiAblIs('mq1060_Reinald', 'vitality', 80, 0, 0) && GMTestAiAblIs('mq1060_Reinald', 'fire_resistance_perc', 0, 0, 0)
		&& GMTestAiAblIs('mq1060_Reinald', 'staminaRegen', 0, 0.25, 0)
		&& GMTestAiAblIs('ConDefaultSilver', 'essence', 80, 0, 0) && GMTestAiAblIs('ConDefaultSilver', 'fire_resistance_perc', 0, 0, 0)
		&& GMTestAiAblIs('ConDefaultSilver', 'light_attack_damage_vitality', 0, 0, 0),
		"DA5 (proposed) " + GMTestAiAblText('mq1060_Reinald', 'vitality') + ", " + GMTestAiAblText('mq1060_Reinald', 'staminaRegen') + ", "
		+ GMTestAiAblText('ConDefaultSilver', 'essence') + " (Reinald's template legacy's ConDefault: 80 Vitality, no fire resistance; plague victims 80 Essence; 5.x 25 and 25)");
}

// The enemies gmtest_ai03_spawn() places (kind or entity path, short label).
function GMTestAi03Kinds(out labels : array<string>) : array<string>
{
	var k : array<string>;

	k.PushBack("drowner");																labels.PushBack("drowner");
	k.PushBack("nekker");																labels.PushBack("nekker");
	k.PushBack("characters\npc_entities\monsters\gryphon_lvl1.w2ent");					labels.PushBack("griffin");
	k.PushBack("golem");																labels.PushBack("golem");
	k.PushBack("arachas");																labels.PushBack("arachas");
	k.PushBack("wolf");																	labels.PushBack("wolf");
	k.PushBack("troll");																labels.PushBack("troll");
	k.PushBack("characters\npc_entities\monsters\bies_lvl2.w2ent");						labels.PushBack("fiend");
	k.PushBack("living_world\enemy_templates\nilfgaardian_deserter_sword_hard.w2ent");	labels.PushBack("deserter in plate");
	k.PushBack("living_world\enemy_templates\baron_renegade_axe.w2ent");				labels.PushBack("renegade with an axe");
	k.PushBack("quests\minor_quests\no_mans_land\quest_files\mq1060_devils_pit\characters\mq1060_witcher.w2ent");	labels.PushBack("Reinald");
	k.PushBack("quests\minor_quests\no_mans_land\quest_files\mq1060_devils_pit\characters\mq1060_evil_spirit.w2ent");	labels.PushBack("red-plague creature");
	k.PushBack("quests\minor_quests\no_mans_land\quest_files\mq1060_devils_pit\characters\mq1060_plague_victim_hostile.w2ent");	labels.PushBack("plague victim");
	// AI-19's abilities, given whole ahead of C3 (AI-A audit F1)
	k.PushBack("dlc\ep1\data\quests\quest_files\q604_mansion\characters\q604_caretaker.w2ent");	labels.PushBack("Caretaker");
	k.PushBack("dlc\ep1\data\quests\quest_files\q604_mansion\characters\q604_shade.w2ent");		labels.PushBack("Caretaker's shade");
	return k;
}

exec function gmtest_ai03_spawn()
{
	var kinds, labels : array<string>;
	var i, p : int;

	p = thePlayer.GetLevel();
	thePlayer.GMTestDummyClearAll();
	thePlayer.GMTestAi01Reset(p);
	kinds = GMTestAi03Kinds(labels);
	for(i = 0; i < kinds.Size(); i += 1)
		GMTestAiSpawn(kinds[i], p, false, 4 + 4 * i);
	LogChannel('GMTest', "INFO AI-03 " + thePlayer.gmTestDummies.Size() + " enemies spawned at Geralt's level " + p + "; read them in a later call");
}

// Expected values per enemy (legacy's data for the abilities its entity has, read off the definitions
// offline: tools/gen_ai.py's files and legacy-GM): template health base (before the per-level
// abilities), armor, one resistance, weapon damage. -1: not checked.
function GMTestAi03Expected(label : string, out health : float, out armor : float, out resName : name, out res : float, out weapon : float)
{
	health = -1; armor = -1; resName = ''; res = -1; weapon = -1;
	switch(label)
	{
		case "drowner":					health = 300;	armor = 0;		resName = 'will_resistance_perc';		res = 0.5;	weapon = 300;	break;	// 5.x 220 Essence, claws 150
		case "nekker":					health = 250;	armor = 0;		resName = 'slashing_resistance_perc';	res = 0;	weapon = 300;	break;	// 5.x 60
		case "griffin":					health = 900;	armor = 15;		resName = 'slashing_resistance_perc';	res = 0.2;	weapon = 500;	break;
		case "golem":					health = 1300;	armor = 200;	resName = 'slashing_resistance_perc';	res = 0.65;	weapon = 600;	break;
		case "arachas":					health = 450;	armor = 60;		resName = 'force_resistance_perc';		res = 0.8;	weapon = 450;	break;	// 5.x 10 Essence, claws 35
		case "wolf":					health = 80;	armor = 0;		resName = 'frost_resistance_perc';		res = 0.3;	weapon = 200;	break;	// 5.x 150 Vitality, bite 150
		case "troll":					health = 1080;	armor = 200;	resName = 'force_resistance_perc';		res = 0.8;	weapon = 550;	break;
		case "fiend":					health = 1350;	armor = 60;		resName = 'force_resistance_perc';		res = 1;	weapon = 600;	break;
		case "deserter in plate":		health = 80;	armor = 120;	resName = 'will_resistance_perc';		res = 0.2;	weapon = 320;	break;	// 5.x armor 50, sword 240
		case "renegade with an axe":	health = 80;	armor = 30;		resName = 'slashing_resistance_perc';	res = 0.07;	weapon = 300;	break;	// 5.x armor 8, axe 200
		case "Reinald":					health = 1880;	armor = 0;		resName = 'bleeding_DoT_damage_resistance_perc';	res = 0.5;	break;	// DA5: ConDefault's 80 + Boss 1000 + Gundar's 800
		case "red-plague creature":		health = 1350;	armor = 0;		resName = 'slashing_resistance_perc';	res = 0.5;	weapon = 600;	break;	// the Hym's (5.x 10,000) and the leshen's
		case "plague victim":			health = 80;	armor = 0;		resName = 'fire_resistance_perc';		res = 0;	weapon = 200;	break;	// DA5: ConDefaultSilver 80 Essence (5.x 25, 50% fire)
		case "Caretaker":				health = 3450;	armor = 200;	resName = 'slashing_resistance_perc';	res = 0.3;	break;	// legacy's mon_caretaker_ep1 3000 and 200 armor, q604_caretaker 30%, legacy's mon_wild_hunt_default 450 (since AI-15, slice C1; 5.x's 1, x0.4); 5.x: 1 x 2.7 Essence, 100 armor, 40%, attack power -40%
	}
}

function GMTestAi03Abilities(npc : CNewNPC) : string
{
	var abls : array<name>;
	var i : int;
	var s : string;
	var levelAbls : array<name>;

	levelAbls = GMTestAiLevelAbls();
	npc.GetCharacterStats().GetAbilities(abls, false);
	for(i = 0; i < abls.Size(); i += 1)
	{
		if(levelAbls.Contains(abls[i]) || abls[i] == 'DisplayedLevelAbl')
			continue;
		if(StrLen(s) > 0)
			s += ",";
		s += NameToString(abls[i]);
	}
	return s;
}

exec function gmtest_ai03_read()
{
	var kinds, labels : array<string>;
	var i, n, p : int;
	var npc : CNewNPC;
	var healthAttr, kindAbl, resName : name;
	var hAttr, apAttr, fAttr : SAbilityAttributeValue;
	var b, m, a, hb0, maxHealth, predicted, armor, eHealth, eArmor, eRes, eWeapon, wdmg : float;
	var noTags, dts, abls : array<name>;
	var j, count : int;
	var weaponId : SItemUniqueId;
	var inv : CInventoryComponent;
	var wtext : string;
	var item : SAbilityAttributeValue;

	thePlayer.GMTestCount(true, true);
	p = thePlayer.GetLevel();
	kinds = GMTestAi03Kinds(labels);
	abls = GMTestAiLevelAbls();
	for(i = 0; i < thePlayer.gmTestDummies.Size() && i < labels.Size(); i += 1)
	{
		npc = thePlayer.gmTestDummies[i];
		if(!npc)
		{
			GMTestReport(false, "AI-03 " + labels[i] + " did not spawn");
			continue;
		}
		n = npc.currentLevel - 1;
		kindAbl = '';
		for(j = 0; j < abls.Size(); j += 1)
			if(npc.GetAbilityCount(abls[j]) > 0)
				kindAbl = abls[j];
		if(npc.GetStatMax(BCS_Vitality) > 0)
			healthAttr = 'vitality';
		else
			healthAttr = 'essence';
		hAttr = npc.GetCharacterStats().GetAttributeValue(healthAttr, noTags);
		apAttr = npc.GetCharacterStats().GetAttributeValue('attack_power', noTags);
		hb0 = hAttr.valueBase;
		if(n > 0 && kindAbl != '')
		{
			GMTestAiAbl(kindAbl, healthAttr, b, m, a);
			hb0 -= npc.GetAbilityCount(kindAbl) * b;
		}
		if(healthAttr == 'vitality')
			maxHealth = npc.GetStatMax(BCS_Vitality);
		else
			maxHealth = npc.GetStatMax(BCS_Essence);
		fAttr = npc.GetCharacterStats().GetAttributeValue('health_final_multiplier', noTags);
		predicted = CalculateAttributeValue(hAttr) * MaxF(fAttr.valueAdditive, 0.0001);
		armor = CalculateAttributeValue(npc.GetTotalArmor());
		// the held weapon (or the first) and its damage
		inv = npc.GetInventory();
		weaponId = GMTestNpcWeapon(npc);
		wtext = "none";
		wdmg = 0;
		if(inv.IsIdValid(weaponId))
		{
			wtext = NameToString(inv.GetItemName(weaponId));
			dts.Clear();
			inv.GetWeaponDTNames(weaponId, dts);
			for(j = 0; j < dts.Size(); j += 1)
			{
				item = inv.GetItemAttributeValue(weaponId, dts[j]);
				item.valueMultiplicative = 1;
				wtext += " " + dts[j] + " " + NoTrailZeros(CalculateAttributeValue(item));
				if(j == 0)
					wdmg = CalculateAttributeValue(item);
			}
		}
		LogChannel('GMTest', "INFO AI-03 " + labels[i] + " (" + npc.GetReadableName() + ") level " + npc.currentLevel + " shown " + npc.GetLevel() + ", " + n + " x " + kindAbl
			+ "; max " + healthAttr + " " + NoTrailZeros(maxHealth) + " (template base " + NoTrailZeros(hb0) + ", attribute " + NoTrailZeros(hAttr.valueBase) + "/" + NoTrailZeros(hAttr.valueMultiplicative)
			+ "/" + NoTrailZeros(hAttr.valueAdditive) + ", x " + NoTrailZeros(MaxF(fAttr.valueAdditive, 0.0001)) + "); armor " + NoTrailZeros(armor)
			+ "; slashing " + NoTrailZeros(GMTestDummyRead(npc, 'slashing_resistance_perc')) + ", piercing " + NoTrailZeros(GMTestDummyRead(npc, 'piercing_resistance_perc'))
			+ ", bludgeoning " + NoTrailZeros(GMTestDummyRead(npc, 'bludgeoning_resistance_perc')) + ", rending " + NoTrailZeros(GMTestDummyRead(npc, 'rending_resistance_perc'))
			+ ", elemental " + NoTrailZeros(GMTestDummyRead(npc, 'elemental_resistance_perc')) + ", force " + NoTrailZeros(GMTestDummyRead(npc, 'force_resistance_perc'))
			+ ", burning " + NoTrailZeros(GMTestDummyRead(npc, 'burning_resistance_perc')) + ", fire " + NoTrailZeros(GMTestDummyRead(npc, 'fire_resistance_perc'))
			+ ", frost " + NoTrailZeros(GMTestDummyRead(npc, 'frost_resistance_perc')) + ", will " + NoTrailZeros(GMTestDummyRead(npc, 'will_resistance_perc'))
			+ ", poison " + NoTrailZeros(GMTestDummyRead(npc, 'poison_resistance_perc')) + ", bleeding " + NoTrailZeros(GMTestDummyRead(npc, 'bleeding_resistance_perc'))
			+ ", DoT burning/poison/bleeding " + NoTrailZeros(GMTestDummyRead(npc, 'burning_DoT_damage_resistance_perc')) + "/" + NoTrailZeros(GMTestDummyRead(npc, 'poison_DoT_damage_resistance_perc'))
			+ "/" + NoTrailZeros(GMTestDummyRead(npc, 'bleeding_DoT_damage_resistance_perc'))
			+ "; attack power " + NoTrailZeros(apAttr.valueBase) + "/" + NoTrailZeros(apAttr.valueMultiplicative) + "/" + NoTrailZeros(apAttr.valueAdditive)
			+ "; weapon " + wtext);
		LogChannel('GMTest', "INFO AI-03 " + labels[i] + " abilities: " + GMTestAi03Abilities(npc));
		// A1's formula still holds with A2's data
		GMTestReport(AbsF(maxHealth - predicted) < 0.5 && maxHealth > 0, "AI-01 " + labels[i] + ": max " + healthAttr + " " + NoTrailZeros(maxHealth) + " = attribute x difficulty " + NoTrailZeros(predicted));
		// shown level = level (5.x's wolf ability showed 4 more)
		GMTestReport(npc.GetLevel() == npc.currentLevel, "AI-03 " + labels[i] + " shows its level: " + npc.GetLevel() + " (" + npc.currentLevel + ")");
		GMTestAi03Expected(labels[i], eHealth, eArmor, resName, eRes, eWeapon);
		if(eHealth >= 0)
			GMTestReport(AbsF(hb0 - eHealth) < 0.5, "AI-03 " + labels[i] + " template " + healthAttr + " base " + NoTrailZeros(hb0) + " (legacy's " + NoTrailZeros(eHealth) + ")");
		if(eArmor >= 0)
			GMTestReport(AbsF(armor - eArmor) < 0.5, "AI-03 " + labels[i] + " armor " + NoTrailZeros(armor) + " (legacy's " + NoTrailZeros(eArmor) + ")");
		if(eRes >= 0)
			GMTestReport(AbsF(GMTestDummyRead(npc, resName) - eRes) < 0.001, "AI-03 " + labels[i] + " " + resName + " " + NoTrailZeros(GMTestDummyRead(npc, resName)) + " (legacy's " + NoTrailZeros(eRes) + ")");
		if(eWeapon >= 0)
			GMTestReport(AbsF(wdmg - eWeapon) < 0.5, "AI-05 " + labels[i] + "'s weapon " + wtext + " (legacy's " + NoTrailZeros(eWeapon) + ")");
	}
	LogChannel('GMTest', "SUMMARY ai03_read: " + thePlayer.gmTestPassed + " passed, " + thePlayer.gmTestFailed + " failed");
}

// Scripted hits both ways with the i-th spawned enemy (0-based): Geralt's light and heavy attack on it and
// its light attack on Geralt, each step logged by the damage probe against the formula (gmtest_dmg's).
// Needs Geralt's sword drawn (gmtest_draw()).
exec function gmtest_ai03_probe(i : int)
{
	var npc : CNewNPC;
	var weaponId : SItemUniqueId;
	var probes : bool;

	npc = thePlayer.gmTestDummies[i];
	weaponId = thePlayer.GetInventory().GetItemFromSlot('r_weapon');
	if(!npc || !thePlayer.GetInventory().IsIdValid(weaponId))
	{
		GMTestReport(false, "AI-03 probe: no enemy " + i + " or no sword drawn");
		return;
	}
	thePlayer.GMTestCount(true, true);
	GMTestDummyFreeze(npc);
	probes = GMTestProbes();
	thePlayer.GMTestSetProbes(true);
	GMTestDmgHit(thePlayer, npc, weaponId, 'attack_light');
	GMTestDmgLogSteps("Geralt's light attack on " + npc.GetDisplayName(), false);
	GMTestDmgHit(npc, thePlayer, GMTestNpcWeapon(npc), 'attack_light');
	GMTestDmgLogSteps(npc.GetDisplayName() + "'s light attack (" + npc.GetInventory().GetItemName(GMTestNpcWeapon(npc)) + ") on Geralt", false, false, GMTestDmgFinalMult(npc, thePlayer));
	thePlayer.GMTestSetProbes(probes);
	LogChannel('GMTest', "SUMMARY ai03_probe: " + thePlayer.gmTestPassed + " passed, " + thePlayer.gmTestFailed + " failed");
}

// A real attack of the i-th spawned enemy on Geralt: every other dummy stays frozen, this one runs at
// normal speed; Geralt is immortal (takes and reports damage, cannot die) and the damage probe records
// the hits. Read with gmtest_ai03_fight_b() a few seconds later.
exec function gmtest_ai03_fight_a(i : int)
{
	var npc : CNewNPC;

	npc = thePlayer.gmTestDummies[i];
	if(!npc)
		return;
	GetWitcherPlayer().SetImmortalityMode(AIM_Immortal, AIC_Default, true);
	thePlayer.ForceSetStat(BCS_Vitality, thePlayer.GetStatMax(BCS_Vitality));
	thePlayer.GMTestDmgReset();
	thePlayer.GMTestSetProbes(true);
	npc.SetAnimationSpeedMultiplier(1);
	LogChannel('GMTest', "INFO AI-03 " + npc.GetDisplayName() + " unfrozen; Geralt's vitality " + NoTrailZeros(thePlayer.GetStat(BCS_Vitality)) + " / " + NoTrailZeros(thePlayer.GetStatMax(BCS_Vitality)));
}

exec function gmtest_ai03_fight_b(i : int)
{
	var npc : CNewNPC;
	var j : int;

	npc = thePlayer.gmTestDummies[i];
	LogChannel('GMTest', "INFO AI-03 last hit recorded: dealt " + thePlayer.gmTestDmgDealt + ", raw " + NoTrailZeros(thePlayer.gmTestDmgRawBefore) + ", final " + NoTrailZeros(thePlayer.gmTestDmgFinal)
		+ "; Geralt's vitality " + NoTrailZeros(thePlayer.GetStat(BCS_Vitality)) + " / " + NoTrailZeros(thePlayer.GetStatMax(BCS_Vitality)));
	for(j = 0; j < thePlayer.gmTestDmgSteps.Size(); j += 1)
		GMTestDmgLogStep("real hit", thePlayer.gmTestDmgSteps[j]);
	if(npc)
		GMTestDummyFreeze(npc);
	thePlayer.GMTestSetProbes(false);
	GetWitcherPlayer().SetImmortalityMode(AIM_None, AIC_Default, true);
}

// AI-05, AI-A audit F2: Hearts of Stone's NPC torch ('Torch Blunt Burning', NPC torch _Stats): legacy's 150
// bludgeoning and 5 silver (5.x 20 and 3). A frozen hostile bandit gets the torch; its damage is read off the
// item in its hand, and a scripted light attack of the bandit's with the torch on Geralt is logged step by
// step by the damage probe (Geralt immortal for the hit).
exec function gmtest_ai05_torch()
{
	var npc : CNewNPC;
	var ids : array<SItemUniqueId>;
	var inv : CInventoryComponent;
	var blunt, silver : SAbilityAttributeValue;
	var probes : bool;

	thePlayer.GMTestCount(true, true);
	thePlayer.GMTestDummyClearAll();
	npc = GMTestDummySpawn("human", thePlayer.GetLevel(), 3);
	if(!npc)
		return;
	inv = npc.GetInventory();
	ids = inv.AddAnItem('Torch Blunt Burning', 1);
	blunt = inv.GetItemAttributeValue(ids[0], 'BludgeoningDamage');
	silver = inv.GetItemAttributeValue(ids[0], 'SilverDamage');
	blunt.valueMultiplicative = 1;
	silver.valueMultiplicative = 1;
	GMTestReport(AbsF(CalculateAttributeValue(blunt) - 150) < 0.01 && AbsF(CalculateAttributeValue(silver) - 5) < 0.01,
		"AI-05 the NPC torch in a bandit's inventory: " + NoTrailZeros(CalculateAttributeValue(blunt)) + " bludgeoning, " + NoTrailZeros(CalculateAttributeValue(silver)) + " silver (legacy's 150, 5; 5.x 20, 3)");
	GetWitcherPlayer().SetImmortalityMode(AIM_Immortal, AIC_Default, true);
	probes = GMTestProbes();
	thePlayer.GMTestSetProbes(true);
	GMTestDmgHit(npc, thePlayer, ids[0], 'attack_light');
	GMTestDmgLogSteps(npc.GetDisplayName() + "'s light attack with the torch on Geralt", false, false, GMTestDmgFinalMult(npc, thePlayer));
	thePlayer.GMTestSetProbes(probes);
	GetWitcherPlayer().SetImmortalityMode(AIM_None, AIC_Default, true);
	thePlayer.ForceSetStat(BCS_Vitality, thePlayer.GetStatMax(BCS_Vitality));
	thePlayer.GMTestDummyClearAll();
	LogChannel('GMTest', "SUMMARY ai05_torch: " + thePlayer.gmTestPassed + " passed, " + thePlayer.gmTestFailed + " failed");
}
