// Generated by tools/gen_test_dummy.py; do not edit by hand. The names of the test dummy's step
// abilities (gm_test_dummy.xml) for one stat and sign, largest scale first, with their scales
// (WitcherScript cannot build a name from a string).
// One function per stat: a single large function exhausts the script compiler's memory.
function GMTestDummySteps(stat : name, negative : bool, out names : array<name>, out scales : array<float>)
{
	names.Clear();
	scales.Clear();
	if(stat == 'armor') { GMTestDummySteps0(negative, names, scales); return; }
	if(stat == 'physical_resistance') { GMTestDummySteps1(negative, names, scales); return; }
	if(stat == 'poison_resistance') { GMTestDummySteps2(negative, names, scales); return; }
	if(stat == 'fire_resistance') { GMTestDummySteps3(negative, names, scales); return; }
	if(stat == 'frost_resistance') { GMTestDummySteps4(negative, names, scales); return; }
	if(stat == 'shock_resistance') { GMTestDummySteps5(negative, names, scales); return; }
	if(stat == 'force_resistance') { GMTestDummySteps6(negative, names, scales); return; }
	if(stat == 'slashing_resistance') { GMTestDummySteps7(negative, names, scales); return; }
	if(stat == 'piercing_resistance') { GMTestDummySteps8(negative, names, scales); return; }
	if(stat == 'bludgeoning_resistance') { GMTestDummySteps9(negative, names, scales); return; }
	if(stat == 'rending_resistance') { GMTestDummySteps10(negative, names, scales); return; }
	if(stat == 'elemental_resistance') { GMTestDummySteps11(negative, names, scales); return; }
	if(stat == 'physical_resistance_perc') { GMTestDummySteps12(negative, names, scales); return; }
	if(stat == 'poison_resistance_perc') { GMTestDummySteps13(negative, names, scales); return; }
	if(stat == 'fire_resistance_perc') { GMTestDummySteps14(negative, names, scales); return; }
	if(stat == 'frost_resistance_perc') { GMTestDummySteps15(negative, names, scales); return; }
	if(stat == 'shock_resistance_perc') { GMTestDummySteps16(negative, names, scales); return; }
	if(stat == 'force_resistance_perc') { GMTestDummySteps17(negative, names, scales); return; }
	if(stat == 'slashing_resistance_perc') { GMTestDummySteps18(negative, names, scales); return; }
	if(stat == 'piercing_resistance_perc') { GMTestDummySteps19(negative, names, scales); return; }
	if(stat == 'bludgeoning_resistance_perc') { GMTestDummySteps20(negative, names, scales); return; }
	if(stat == 'rending_resistance_perc') { GMTestDummySteps21(negative, names, scales); return; }
	if(stat == 'elemental_resistance_perc') { GMTestDummySteps22(negative, names, scales); return; }
	if(stat == 'bleeding_resistance_perc') { GMTestDummySteps23(negative, names, scales); return; }
	if(stat == 'will_resistance_perc') { GMTestDummySteps24(negative, names, scales); return; }
	if(stat == 'burning_resistance_perc') { GMTestDummySteps25(negative, names, scales); return; }
	if(stat == 'burning_DoT_damage_resistance_perc') { GMTestDummySteps26(negative, names, scales); return; }
	if(stat == 'poison_DoT_damage_resistance_perc') { GMTestDummySteps27(negative, names, scales); return; }
	if(stat == 'bleeding_DoT_damage_resistance_perc') { GMTestDummySteps28(negative, names, scales); return; }
	if(stat == 'vitality') { GMTestDummySteps29(negative, names, scales); return; }
	if(stat == 'essence') { GMTestDummySteps30(negative, names, scales); return; }
	if(stat == 'attack_power') { GMTestDummySteps31(negative, names, scales); return; }
	if(stat == 'damage_final_multiplier') { GMTestDummySteps32(negative, names, scales); return; }
	if(stat == 'critical_hit_damage_reduction') { GMTestDummySteps33(negative, names, scales); return; }
