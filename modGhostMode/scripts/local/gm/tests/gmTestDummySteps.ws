function GMTestDummySteps0(negative : bool, out names : array<name>, out scales : array<float>)
{
	if(negative) names.PushBack('GMTD_armor_n1000'); else names.PushBack('GMTD_armor_p1000');
	scales.PushBack(1000);
	if(negative) names.PushBack('GMTD_armor_n100'); else names.PushBack('GMTD_armor_p100');
	scales.PushBack(100);
	if(negative) names.PushBack('GMTD_armor_n10'); else names.PushBack('GMTD_armor_p10');
	scales.PushBack(10);
	if(negative) names.PushBack('GMTD_armor_n1'); else names.PushBack('GMTD_armor_p1');
	scales.PushBack(1);
	if(negative) names.PushBack('GMTD_armor_n0.1'); else names.PushBack('GMTD_armor_p0.1');
	scales.PushBack(0.1);
	if(negative) names.PushBack('GMTD_armor_n0.01'); else names.PushBack('GMTD_armor_p0.01');
	scales.PushBack(0.01);
}

