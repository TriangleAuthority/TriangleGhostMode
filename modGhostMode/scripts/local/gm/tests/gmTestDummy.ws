// The test dummy: a hostile NPC that stands still and has exact, known stats, for tests that need
// a predictable opponent (damage, defence). Any NPC template can be the body (a human, a beast, a
// monster of any category; GMTestDummyTemplate below), frozen (GMTestDummyFreeze), so it neither
// moves nor attacks. Its stats are set to exact values with the
// test-only step abilities of gm_test_dummy.xml (generated by tools/gen_test_dummy.py: +/-1000 to
// 0.0001 of one stat each), added in counts until the stat reads back as asked. This works on top of
// whatever the template, its level and the difficulty give, and no real enemy is affected.
//
// Console / tools/game.py (stats are set in a later call than the spawn: the NPC's level bonuses
// are applied by a timer after it spawns):
//   gmtest_dummy("human")              spawn one 2 m in front of Geralt (kinds below, or a template
//                                        path), optional level and distance
//   gmtest_dummy_neutral()             armor 0, every resistance 0, attack power x1, damage x1 (no
//                                        difficulty bonus), 100000 health
//   gmtest_dummy_set('armor', 50)      one stat (names: GMTestDummyStats)
//   gmtest_dummy_info()                stats, position drift, behaviour
//   gmtest_dummy_clear()               remove every dummy
// Tests use GMTestDummySpawn, GMTestDummySet, GMTestDummyNeutral and GMTestDummy() directly.
// See docs/development.md#testing-in-game.

@addField(CR4Player)
var gmTestDummies : array<CNewNPC>;
@addField(CR4Player)
var gmTestDummyHome : array<Vector>;

@addMethod(CR4Player)
function GMTestDummyAdd(npc : CNewNPC, home : Vector)
{
	gmTestDummies.PushBack(npc);
	gmTestDummyHome.PushBack(home);
}

@addMethod(CR4Player)
function GMTestDummyClearAll()
{
	var i : int;

	for(i = 0; i < gmTestDummies.Size(); i += 1)
		if(gmTestDummies[i])
			gmTestDummies[i].Destroy();
	gmTestDummies.Clear();
	gmTestDummyHome.Clear();
}

// The latest dummy, or NULL.
function GMTestDummy() : CNewNPC
{
	var n : int;

	n = thePlayer.gmTestDummies.Size();
	if(n == 0)
		return NULL;
	return thePlayer.gmTestDummies[n - 1];
}

function GMTestDummyHome(npc : CNewNPC) : Vector
{
	var i : int;

	for(i = 0; i < thePlayer.gmTestDummies.Size(); i += 1)
		if(thePlayer.gmTestDummies[i] == npc)
			return thePlayer.gmTestDummyHome[i];
	return npc.GetWorldPosition();
}

// Body templates by kind; anything else is taken as a template path.
function GMTestDummyTemplate(kind : string) : string
{
	switch(kind)
	{
		case "human":		return "dlc\dlc7\data\characters\sq107_bandit_lvl1_mortal.w2ent";	// sword, Vitality
		case "wolf":		return "characters\npc_entities\monsters\wolf_lvl1.w2ent";			// beast, Vitality
		case "drowner":		return "characters\npc_entities\monsters\drowner_lvl1.w2ent";		// necrophage
		case "ghoul":		return "characters\npc_entities\monsters\ghoul_lvl2.w2ent";			// necrophage
		case "nekker":		return "characters\npc_entities\monsters\nekker_lvl1.w2ent";			// ogroid
		case "wraith":		return "characters\npc_entities\monsters\wraith_lvl1.w2ent";			// specter, Essence
		case "nightwraith":	return "characters\npc_entities\monsters\nightwraith_lvl1.w2ent";	// specter
		case "endriaga":	return "characters\npc_entities\monsters\endriaga_lvl2__tailed.w2ent";	// insectoid
		case "arachas":		return "characters\npc_entities\monsters\arachas_lvl1.w2ent";		// insectoid, armored
		case "werewolf":	return "characters\npc_entities\monsters\werewolf_lvl2.w2ent";		// cursed
		case "golem":		return "characters\npc_entities\monsters\golem_lvl2.w2ent";			// elementa
		case "troll":		return "characters\npc_entities\monsters\troll_cave_lvl2.w2ent";		// ogroid, large
		case "bear":		return "characters\npc_entities\monsters\bear_berserker_lvl1.w2ent";	// beast, large
		default:			return kind;
	}
}

// Spawns a hostile (or friendly) dummy at the given distance in front of Geralt (default 2 m), facing him, and
// freezes it. level > 0 sets its level (bonuses follow by timer). Returns NULL on failure.
function GMTestDummySpawn(kind : string, optional level : int, optional distance : float, optional friendly : bool) : CNewNPC
{
	var template : CEntityTemplate;
	var npc : CNewNPC;
	var pos : Vector;

	template = (CEntityTemplate)LoadResource(GMTestDummyTemplate(kind), true);
	if(!template)
	{
		LogChannel('GMTest', "FAIL dummy: template for " + kind + " not found");
		return NULL;
	}
	if(distance <= 0)
		distance = 2;
	pos = thePlayer.GetWorldPosition() + thePlayer.GetHeadingVector() * distance;
	npc = (CNewNPC)theGame.CreateEntity(template, pos, VecToRotation(-thePlayer.GetHeadingVector()));
	if(!npc)
	{
		LogChannel('GMTest', "FAIL dummy: " + kind + " did not spawn an NPC");
		return NULL;
	}
	if(friendly)
		npc.SetTemporaryAttitudeGroup('friendly_to_player', AGP_Default);
	else
		npc.SetTemporaryAttitudeGroup('hostile_to_player', AGP_Default);
	if(level > 0)
		npc.SetLevel(level);
	thePlayer.GMTestDummyAdd(npc, pos);
	GMTestDummyFreeze(npc);
	return npc;
}

// Freezes the dummy: its animations run at 1/1000 speed (the mechanism Yrden's slow uses), so it
// can neither move nor attack, and it stays hostile (in combat, attitude and AI as a real enemy).
// Vanilla's "do nothing" AI action, forced even at emergency priority, does not hold against the
// combat AI. It is put back where it spawned, facing Geralt.
function GMTestDummyFreeze(npc : CNewNPC)
{
	npc.TeleportWithRotation(GMTestDummyHome(npc), VecToRotation(thePlayer.GetWorldPosition() - GMTestDummyHome(npc)));
	npc.SetAnimationSpeedMultiplier(0.001);
}

exec function gmtest_dummy_freeze()
{
	var npc : CNewNPC;

	npc = GMTestDummy();
	if(npc)
		GMTestDummyFreeze(npc);
}

exec function gmtest_dummy_home()
{
	var npc : CNewNPC;

	npc = GMTestDummy();
	if(npc)
		npc.TeleportWithRotation(GMTestDummyHome(npc), VecToRotation(thePlayer.GetWorldPosition() - GMTestDummyHome(npc)));
}

// The stats a dummy can be given (the step abilities of gm_test_dummy.xml; GMTestDummySteps, generated
// with them, gives their names).
function GMTestDummyStats() : array<name>
{
	var s : array<name>;

	s.PushBack('armor');
	s.PushBack('physical_resistance'); s.PushBack('poison_resistance'); s.PushBack('fire_resistance');
	s.PushBack('frost_resistance'); s.PushBack('shock_resistance'); s.PushBack('force_resistance');
	s.PushBack('slashing_resistance'); s.PushBack('piercing_resistance'); s.PushBack('bludgeoning_resistance');
	s.PushBack('rending_resistance'); s.PushBack('elemental_resistance');
	s.PushBack('physical_resistance_perc'); s.PushBack('poison_resistance_perc'); s.PushBack('fire_resistance_perc');
	s.PushBack('frost_resistance_perc'); s.PushBack('shock_resistance_perc'); s.PushBack('force_resistance_perc');
	s.PushBack('slashing_resistance_perc'); s.PushBack('piercing_resistance_perc'); s.PushBack('bludgeoning_resistance_perc');
	s.PushBack('rending_resistance_perc'); s.PushBack('elemental_resistance_perc'); s.PushBack('bleeding_resistance_perc');
	s.PushBack('will_resistance_perc'); s.PushBack('burning_resistance_perc');
	s.PushBack('burning_DoT_damage_resistance_perc'); s.PushBack('poison_DoT_damage_resistance_perc');
	s.PushBack('bleeding_DoT_damage_resistance_perc');
	s.PushBack('vitality'); s.PushBack('essence'); s.PushBack('attack_power'); s.PushBack('damage_final_multiplier');
	s.PushBack('critical_hit_damage_reduction');
	// The point names of bleeding, will and burning resistance (counted with EFX-08).
	s.PushBack('bleeding_resistance'); s.PushBack('will_resistance'); s.PushBack('burning_resistance');
	return s;
}

function GMTestDummyKnownStat(stat : name) : bool
{
	var stats : array<name>;

	stats = GMTestDummyStats();
	return stats.Contains(stat);
}

// A stat as the game reads it: armor as the damage manager reads it, resistances through
// GetResistValue (percentages capped at 1 by the game), health as the stat's maximum, attack power
// as the power stat's multiplier, other attributes as their calculated value.
function GMTestDummyRead(npc : CNewNPC, stat : name) : float
{
	var isPoint : bool;
	var res : ECharacterDefenseStats;
	var pts, perc : float;
	var power : SAbilityAttributeValue;

	if(stat == 'armor')
		return CalculateAttributeValue(npc.GetTotalArmor());
	if(stat == 'vitality')
		return npc.GetStatMax(BCS_Vitality);
	if(stat == 'essence')
		return npc.GetStatMax(BCS_Essence);
	if(stat == 'attack_power')
	{
		power = npc.GetPowerStatValue(CPS_AttackPower);
		return power.valueMultiplicative;
	}
	if(stat == 'critical_hit_damage_reduction')	// the damage manager reads its multiplier: 1 = crits add no damage
	{
		power = npc.GetAttributeValue(stat);
		return power.valueMultiplicative;
	}
	res = ResistStatNameToEnum(stat, isPoint);
	if(res != CDS_None)
	{
		npc.GetResistValue(res, pts, perc);
		if(isPoint)
			return pts;
		return perc;
	}
	return CalculateAttributeValue(npc.GetAttributeValue(stat));
}

function GMTestDummySmallScale(stat : name) : bool
{
	return StrEndsWith(NameToString(stat), "_perc") || stat == 'attack_power' || stat == 'damage_final_multiplier'
		|| stat == 'critical_hit_damage_reduction';
}

// Adds the step abilities for a change of delta (greedy, largest scale first; the rest is rounded
// to the smallest scale).
function GMTestDummyApply(npc : CNewNPC, stat : name, delta : float)
{
	var names : array<name>;
	var scales : array<float>;
	var i, count : int;
	var left : float;

	GMTestDummySteps(stat, delta < 0, names, scales);
	if(names.Size() == 0)
	{
		LogChannel('GMTest', "INFO dummy: no step abilities for " + stat);
		return;
	}
	left = AbsF(delta) + scales[scales.Size() - 1] * 0.5;
	for(i = 0; i < scales.Size(); i += 1)
	{
		count = FloorF(left / scales[i]);
		if(count > 0)
		{
			npc.AddAbilityMultiple(names[i], count);
			left -= count * scales[i];
		}
	}
}

// Sets a stat to value. Health and percentages pass through the game's multipliers and caps, so the
// change is measured and corrected up to three times. Returns whether the stat reads back as asked.
function GMTestDummySet(npc : CNewNPC, stat : name, value : float) : bool
{
	var i : int;
	var current, delta, applied, achieved, slope, tol : float;

	if(!GMTestDummyKnownStat(stat))
		return false;

	tol = 0.00015;
	if(!GMTestDummySmallScale(stat))
		tol = 0.015;
	slope = 1;
	for(i = 0; i < 3; i += 1)
	{
		current = GMTestDummyRead(npc, stat);
		delta = value - current;
		if(AbsF(delta) <= tol)
			return true;
		applied = delta / slope;
		GMTestDummyApply(npc, stat, applied);
		achieved = GMTestDummyRead(npc, stat) - current;
		if(AbsF(achieved) > tol && AbsF(applied) > tol)
			slope = achieved / applied;
	}
	return AbsF(GMTestDummyRead(npc, stat) - value) <= tol;
}

// The neutral configuration: no armor, no resistance of any kind, attack power x1, its damage x1
// (5.x multiplies an attacker's raw damage by damage_final_multiplier, the difficulty's), 100000
// health (Vitality or Essence, the one it uses), at full health.
function GMTestDummyNeutral(npc : CNewNPC) : bool
{
	var stats : array<name>;
	var i : int;
	var ok : bool;

	ok = true;
	stats = GMTestDummyStats();
	for(i = 0; i < stats.Size(); i += 1)
	{
		if(stats[i] == 'vitality' || stats[i] == 'essence' || stats[i] == 'attack_power' || stats[i] == 'damage_final_multiplier'
			|| stats[i] == 'critical_hit_damage_reduction')
			continue;
		if(!GMTestDummySet(npc, stats[i], 0))
		{
			ok = false;
			LogChannel('GMTest', "INFO dummy: " + stats[i] + " reads " + NoTrailZeros(GMTestDummyRead(npc, stats[i])) + ", asked 0");
		}
	}
	if(!GMTestDummySet(npc, 'attack_power', 1))
		ok = false;
	if(!GMTestDummySet(npc, 'damage_final_multiplier', 1))
		ok = false;
	if(npc.UsesEssence())
		ok = GMTestDummySet(npc, 'essence', 100000) && ok;
	else
		ok = GMTestDummySet(npc, 'vitality', 100000) && ok;
	GMTestDummyHeal(npc);
	return ok;
}

function GMTestDummyHeal(npc : CNewNPC)
{
	if(npc.UsesEssence())
		npc.ForceSetStat(BCS_Essence, npc.GetStatMax(BCS_Essence));
	else
		npc.ForceSetStat(BCS_Vitality, npc.GetStatMax(BCS_Vitality));
}

function GMTestDummyLogInfo(npc : CNewNPC)
{
	var stats : array<name>;
	var i : int;
	var line : string;
	var category : EMonsterCategory;
	var tmpName : name;
	var tmpBool : bool;

	theGame.GetMonsterParamsForActor(npc, category, tmpName, tmpBool, tmpBool, tmpBool);
	LogChannel('GMTest', "INFO dummy " + npc.GetDisplayName() + " level " + npc.GetLevel() + ", human " + npc.IsHuman()
		+ ", monster category " + category + ", uses " + (npc.UsesEssence() ? "Essence" : "Vitality")
		+ ", drift " + NoTrailZeros(VecDistance2D(npc.GetWorldPosition(), GMTestDummyHome(npc))) + " m, "
		+ NoTrailZeros(VecDistance(npc.GetWorldPosition(), thePlayer.GetWorldPosition())) + " m from Geralt, hostile "
		+ (GetAttitudeBetween(thePlayer, npc) == AIA_Hostile) + ", alive " + npc.IsAlive());
	stats = GMTestDummyStats();
	for(i = 0; i < stats.Size(); i += 1)
	{
		line += NameToString(stats[i]) + " " + NoTrailZeros(RoundF(GMTestDummyRead(npc, stats[i]) * 10000) / 10000.0) + "; ";
		if(i % 8 == 7 || i == stats.Size() - 1)
		{
			LogChannel('GMTest', "INFO   " + line);
			line = "";
		}
	}
}

exec function gmtest_dummy(kind : string, optional level : int, optional distance : float, optional friendly : bool)
{
	var npc : CNewNPC;

	npc = GMTestDummySpawn(kind, level, distance, friendly);
	if(npc)
		LogChannel('GMTest', "INFO dummy " + kind + " spawned (" + thePlayer.gmTestDummies.Size() + " in all); set its stats in a later call");
}

exec function gmtest_dummy_neutral()
{
	var npc : CNewNPC;

	npc = GMTestDummy();
	if(!npc)
	{
		GMTestReport(false, "dummy: none spawned");
		return;
	}
	GMTestReport(GMTestDummyNeutral(npc), "dummy: neutral stats read back as set (armor and resistances 0, attack power x1, damage x1, 100000 health)");
}

exec function gmtest_dummy_set(stat : name, value : float)
{
	var npc : CNewNPC;

	npc = GMTestDummy();
	if(!npc)
	{
		GMTestReport(false, "dummy: none spawned");
		return;
	}
	if(!GMTestDummyKnownStat(stat))
	{
		GMTestReport(false, "dummy: unknown stat " + stat + " (the names are in GMTestDummyStats)");
		return;
	}
	GMTestReport(GMTestDummySet(npc, stat, value), "dummy: " + stat + " reads back " + NoTrailZeros(GMTestDummyRead(npc, stat))
		+ ", asked " + NoTrailZeros(value));
}

exec function gmtest_dummy_info()
{
	var i : int;

	for(i = 0; i < thePlayer.gmTestDummies.Size(); i += 1)
		if(thePlayer.gmTestDummies[i])
			GMTestDummyLogInfo(thePlayer.gmTestDummies[i]);
}

exec function gmtest_dummy_clear()
{
	thePlayer.GMTestDummyClearAll();
	LogChannel('GMTest', "INFO dummies removed");
}
