// ARM-05: the set framework. Every tier of the four school sets counts towards the minor bonus
// (tier 1, 3 pieces); the full bonus (tier 2, 6 pieces) needs grandmaster pieces. Lower tiers are
// tagged `<School>SetMinor` (gm_arm_items.xml, generated by tools/gen_arm_items.py) and counted
// under their own set types. Viper and Kaer Morhen join the set types. ARM-15 (DA3): the Netflix set's
// lower tiers count towards its first bonus too (`NetflixSetMinor`, armor/netflixSet.ws).

// ARM-05: minor tiers, Viper and Kaer Morhen (legacy's members).
enum EItemSetBonus
{
	EISB_Viper,
	EISB_KaerMorhen
}

enum EItemSetType
{
	EIST_KaerMorhen,
	EIST_Lynx_Minor,
	EIST_Gryphon_Minor,
	EIST_Bear_Minor,
	EIST_Wolf_Minor,
	EIST_Netflix_Minor
}

// ARM-05: pieces needed for a set's first and full bonus (legacy: Kaer Morhen's full set is 4).
function GMGetNumItemsRequiredForSetActivation( setType : EItemSetType ) : int
{
	return theGame.params.ITEMS_REQUIRED_FOR_MINOR_SET_BONUS;
}

function GMGetNumItemsRequiredForFullSet( setType : EItemSetType ) : int
{
	switch( setType )
	{
		case EIST_KaerMorhen:
			return 4;
		default:
			return theGame.params.ITEMS_REQUIRED_FOR_MAJOR_SET_BONUS;
	}
}

// ARM-05: whether a set type is a lower tier of a school set.
function GMIsMinorSetType( setType : EItemSetType ) : bool
{
	return setType == EIST_Lynx_Minor || setType == EIST_Gryphon_Minor || setType == EIST_Bear_Minor || setType == EIST_Wolf_Minor || setType == EIST_Netflix_Minor;
}

// ARM-05: minor tiers and Kaer Morhen.
@replaceMethod
function SetItemNameToType( nam : name ) : EItemSetType
{
	switch( nam )
	{
		case theGame.params.ITEM_SET_TAG_LYNX : 			return EIST_Lynx ;
		case theGame.params.ITEM_SET_TAG_GRYPHON : 			return EIST_Gryphon ;
		case theGame.params.ITEM_SET_TAG_BEAR : 			return EIST_Bear ;
		case theGame.params.ITEM_SET_TAG_WOLF : 			return EIST_Wolf ;
		case theGame.params.ITEM_SET_TAG_RED_WOLF : 		return EIST_RedWolf ;
		case theGame.params.ITEM_SET_TAG_VAMPIRE :			return EIST_Vampire ;
		case theGame.params.ITEM_SET_TAG_VIPER : 			return EIST_Viper;

		case theGame.params.ITEM_SET_TAG_NETFLIX : 			return EIST_Netflix;
		case 'KaerMorhenSet' :								return EIST_KaerMorhen;		//modSigns
		case 'LynxSetMinor' :								return EIST_Lynx_Minor;		//modSigns
		case 'GryphonSetMinor' :							return EIST_Gryphon_Minor;	//modSigns
		case 'BearSetMinor' :								return EIST_Bear_Minor;		//modSigns
		case 'WolfSetMinor' :								return EIST_Wolf_Minor;		//modSigns
		case 'NetflixSetMinor' :							return EIST_Netflix_Minor;	//modSigns: ARM-15
		default: 											return EIST_Undefined;
	}
}

// ARM-05: the minor tiers count towards tier 1; Viper and Kaer Morhen.
@replaceMethod(W3PlayerWitcher)
function IsSetBonusActive( bonus : EItemSetBonus ) : bool
{
	switch(bonus)
	{
		case EISB_Lynx_1:			return GetSetPartsEquipped( EIST_Lynx ) >= theGame.params.ITEMS_REQUIRED_FOR_MINOR_SET_BONUS;	//modSigns
		case EISB_Lynx_2:			return amountOfSetPiecesEquipped[ EIST_Lynx ] >= theGame.params.ITEMS_REQUIRED_FOR_MAJOR_SET_BONUS;
		case EISB_Gryphon_1:		return GetSetPartsEquipped( EIST_Gryphon ) >= theGame.params.ITEMS_REQUIRED_FOR_MINOR_SET_BONUS;	//modSigns
		case EISB_Gryphon_2:		return amountOfSetPiecesEquipped[ EIST_Gryphon ] >= theGame.params.ITEMS_REQUIRED_FOR_MAJOR_SET_BONUS;
		case EISB_Bear_1:			return GetSetPartsEquipped( EIST_Bear ) >= theGame.params.ITEMS_REQUIRED_FOR_MINOR_SET_BONUS;	//modSigns
		case EISB_Bear_2:			return amountOfSetPiecesEquipped[ EIST_Bear ] >= theGame.params.ITEMS_REQUIRED_FOR_MAJOR_SET_BONUS;
		case EISB_Wolf_1:			return GetSetPartsEquipped( EIST_Wolf ) >= theGame.params.ITEMS_REQUIRED_FOR_MINOR_SET_BONUS;	//modSigns
		case EISB_Wolf_2:			return !gmWolfBleedingOff && amountOfSetPiecesEquipped[ EIST_Wolf ] >= theGame.params.ITEMS_REQUIRED_FOR_MAJOR_SET_BONUS;	//modSigns: ARM-09, off while 5.x's bleeding rule in InternalAddEffect runs (armor/wolfSet.ws)
		case EISB_RedWolf_1:		return amountOfSetPiecesEquipped[ EIST_RedWolf ] >= theGame.params.ITEMS_REQUIRED_FOR_MINOR_SET_BONUS;
		case EISB_RedWolf_2:		return amountOfSetPiecesEquipped[ EIST_RedWolf ] >= theGame.params.ITEMS_REQUIRED_FOR_MAJOR_SET_BONUS;

		case EISB_Vampire:			return amountOfSetPiecesEquipped[ EIST_Vampire ] >= theGame.params.ITEMS_REQUIRED_FOR_MINOR_SET_BONUS;
		case EISB_Netflix_1:		return GetSetPartsEquipped( EIST_Netflix ) >= theGame.params.ITEMS_REQUIRED_FOR_MINOR_SET_BONUS;	//modSigns: ARM-15, every tier (DA3)
		case EISB_Netflix_2:		return amountOfSetPiecesEquipped[ EIST_Netflix ] >= theGame.params.ITEMS_REQUIRED_FOR_MAJOR_SET_BONUS;
		case EISB_Viper:			return amountOfSetPiecesEquipped[ EIST_Viper ] >= GMGetNumItemsRequiredForSetActivation( EIST_Viper );			//modSigns
		case EISB_KaerMorhen:		return amountOfSetPiecesEquipped[ EIST_KaerMorhen ] >= GMGetNumItemsRequiredForSetActivation( EIST_KaerMorhen );	//modSigns
		default:					return false;
	}
}

// ARM-05: a school set's pieces of every tier together.
@replaceMethod(W3PlayerWitcher)
function GetSetPartsEquipped( setType : EItemSetType ) : int
{
	switch( setType )	//modSigns
	{	//modSigns
		case EIST_Lynx:	//modSigns
		case EIST_Lynx_Minor:	//modSigns
			return amountOfSetPiecesEquipped[ EIST_Lynx ] + amountOfSetPiecesEquipped[ EIST_Lynx_Minor ];	//modSigns
		case EIST_Gryphon:	//modSigns
		case EIST_Gryphon_Minor:	//modSigns
			return amountOfSetPiecesEquipped[ EIST_Gryphon ] + amountOfSetPiecesEquipped[ EIST_Gryphon_Minor ];	//modSigns
		case EIST_Bear:	//modSigns
		case EIST_Bear_Minor:	//modSigns
			return amountOfSetPiecesEquipped[ EIST_Bear ] + amountOfSetPiecesEquipped[ EIST_Bear_Minor ];	//modSigns
		case EIST_Wolf:	//modSigns
		case EIST_Wolf_Minor:	//modSigns
			return amountOfSetPiecesEquipped[ EIST_Wolf ] + amountOfSetPiecesEquipped[ EIST_Wolf_Minor ];	//modSigns
		case EIST_Netflix:	//modSigns: ARM-15
		case EIST_Netflix_Minor:	//modSigns
			return amountOfSetPiecesEquipped[ EIST_Netflix ] + amountOfSetPiecesEquipped[ EIST_Netflix_Minor ];	//modSigns
		default:	//modSigns
			return amountOfSetPiecesEquipped[ setType ];
	}	//modSigns
}

// ARM-05: the pieces of one set type (one tier group) only.
@addMethod(W3PlayerWitcher)
public function GMGetSetPartsEquippedRaw( setType : EItemSetType ) : int
{
	return amountOfSetPiecesEquipped[ setType ];
}

// ARM-05: lower-tier and grandmaster pieces of one school worn together.
@addMethod(W3PlayerWitcher)
public function GMHasMixedSetsEquipped() : bool
{
	return	amountOfSetPiecesEquipped[ EIST_Lynx ] > 0 && amountOfSetPiecesEquipped[ EIST_Lynx_Minor ] > 0 ||
			amountOfSetPiecesEquipped[ EIST_Gryphon ] > 0 && amountOfSetPiecesEquipped[ EIST_Gryphon_Minor ] > 0 ||
			amountOfSetPiecesEquipped[ EIST_Bear ] > 0 && amountOfSetPiecesEquipped[ EIST_Bear_Minor ] > 0 ||
			amountOfSetPiecesEquipped[ EIST_Wolf ] > 0 && amountOfSetPiecesEquipped[ EIST_Wolf_Minor ] > 0 ||
			amountOfSetPiecesEquipped[ EIST_Netflix ] > 0 && amountOfSetPiecesEquipped[ EIST_Netflix_Minor ] > 0;
}

// ARM-05: recounts the set pieces worn (legacy's RecalcSetItemsEquipped, run once on old saves;
// the port runs it at every load, so saves made before the mod or with other tags count right).
@addMethod(W3PlayerWitcher)
public function GMRecalcSetItemsEquipped()
{
	var slotsToCheck : array<EEquipmentSlots>;
	var setType : EItemSetType;
	var item : SItemUniqueId;
	var i : int;

	for(i = 0; i < amountOfSetPiecesEquipped.Size(); i += 1)
		amountOfSetPiecesEquipped[i] = 0;

	slotsToCheck.PushBack(EES_Armor);
	slotsToCheck.PushBack(EES_Boots);
	slotsToCheck.PushBack(EES_Pants);
	slotsToCheck.PushBack(EES_Gloves);
	slotsToCheck.PushBack(EES_SilverSword);
	slotsToCheck.PushBack(EES_SteelSword);

	for(i = 0; i < slotsToCheck.Size(); i += 1)
	{
		if(GetItemEquippedOnSlot(slotsToCheck[i], item) && inv.ItemHasTag(item, theGame.params.ITEM_SET_TAG_BONUS))
		{
			setType = CheckSetType( item );
			amountOfSetPiecesEquipped[ setType ] += 1;
		}
	}
	ManageSetBonusesSoundbanks( EIST_Lynx );
	ManageSetBonusesSoundbanks( EIST_Gryphon );
	ManageSetBonusesSoundbanks( EIST_Bear );
}

// ARM-05: minor tiers count towards the tutorial; the achievement as legacy (any full bonus).
@replaceMethod(W3PlayerWitcher)
function UpdateItemSetBonuses( item : SItemUniqueId, increment : bool )
{
	var setType : EItemSetType;
	var tutorialStateSets : W3TutorialManagerUIHandlerStateSetItemsUnlocked;
	var id : SItemUniqueId;

	if( !inv.IsIdValid( item ) || !inv.ItemHasTag(item, theGame.params.ITEM_SET_TAG_BONUS ) )
	{
		GMRemoveExtraOilsFromSwords();	//modSigns: ARM-09, extra oils go without the Wolven tier 2 (legacy)
		return;
	}

	setType = CheckSetType( item );

	if( increment )
	{
		amountOfSetPiecesEquipped[ setType ] += 1;

		if( GetSetPartsEquipped( setType ) >= GMGetNumItemsRequiredForSetActivation( setType ) && ShouldProcessTutorial( 'TutorialSetBonusesUnlocked' ) && theGame.GetTutorialSystem().uiHandler && theGame.GetTutorialSystem().uiHandler.GetCurrentStateName() == 'SetItemsUnlocked' )	//modSigns
		{
			tutorialStateSets = ( W3TutorialManagerUIHandlerStateSetItemsUnlocked )theGame.GetTutorialSystem().uiHandler.GetCurrentState();
			tutorialStateSets.OnSetBonusCompleted();
		}
	}
	else if( amountOfSetPiecesEquipped[ setType ] > 0 )
	{
		amountOfSetPiecesEquipped[ setType ] -= 1;
	}


	if( setType != EIST_Vampire && setType != EIST_Viper && setType != EIST_KaerMorhen && !GMIsMinorSetType( setType ) )	//modSigns: sets without a full bonus count nothing
	{
		if( IsSetBonusActive(EISB_Lynx_2) || IsSetBonusActive(EISB_Gryphon_2) || IsSetBonusActive(EISB_Bear_2) || IsSetBonusActive(EISB_Wolf_2) || IsSetBonusActive(EISB_RedWolf_2) )	//modSigns: legacy
		{
			theGame.GetGamerProfile().AddAchievement( EA_ReadyToRoll );
		}
		else
		{
			theGame.GetGamerProfile().NoticeAchievementProgress( EA_ReadyToRoll, amountOfSetPiecesEquipped[ setType ]);
		}
	}


	GMRemoveExtraOilsFromSwords();	//modSigns: ARM-09, extra oils go without the Wolven tier 2 (legacy)


	ManageActiveSetBonuses( setType );


	ManageSetBonusesSoundbanks( setType );
}

// ARM-05: the Feline buff also ends when lower-tier pieces come off.
@replaceMethod(W3PlayerWitcher)
function ManageActiveSetBonuses( setType : EItemSetType )
{
	var l_i				: int;


	if( setType == EIST_Lynx || setType == EIST_Lynx_Minor )	//modSigns
	{

		if( HasBuff( EET_LynxSetBonus ) && !IsSetBonusActive( EISB_Lynx_1 ) )
		{
			RemoveBuff( EET_LynxSetBonus );
		}
	}

	else if( setType == EIST_Gryphon || setType == EIST_Gryphon_Minor )	//modSigns
	{

		if( !IsSetBonusActive( EISB_Gryphon_1 ) )
		{
			RemoveBuff( EET_GryphonSetBonus );
		}

		if( IsSetBonusActive( EISB_Gryphon_2 ) && !HasBuff( EET_GryphonSetBonusYrden ) )
		{
			for( l_i = 0 ; l_i < yrdenEntities.Size() ; l_i += 1 )
			{
				if( yrdenEntities[ l_i ].GetIsPlayerInside() && !yrdenEntities[ l_i ].IsAlternateCast() )
				{
					AddEffectDefault( EET_GryphonSetBonusYrden, this, "GryphonSetBonusYrden" );
					break;
				}
			}
		}
		else
		{
			RemoveBuff( EET_GryphonSetBonusYrden );
		}
	}
	else if( setType == EIST_KaerMorhen )	//modSigns: ARM-12, the Kaer Morhen set's effect (armor/kaerMorhenSet.ws)
	{	//modSigns
		GMManageKaerMorhenSetBonus();	//modSigns
	}	//modSigns
}

// ARM-05: the minor tiers and Kaer Morhen.
@replaceMethod(W3PlayerWitcher)
function CheckSetTypeByName( itemName : name ) : EItemSetType
{
	var dm : CDefinitionsManagerAccessor;

	dm = theGame.GetDefinitionsManager();

	if( dm.ItemHasTag( itemName, theGame.params.ITEM_SET_TAG_LYNX ) )
	{
		return EIST_Lynx;
	}
	else
	if( dm.ItemHasTag( itemName, theGame.params.ITEM_SET_TAG_GRYPHON ) )
	{
		return EIST_Gryphon;
	}
	else
	if( dm.ItemHasTag( itemName, theGame.params.ITEM_SET_TAG_BEAR ) )
	{
		return EIST_Bear;
	}
	else
	if( dm.ItemHasTag( itemName, theGame.params.ITEM_SET_TAG_WOLF ) )
	{
		return EIST_Wolf;
	}
	else
	if( dm.ItemHasTag( itemName, theGame.params.ITEM_SET_TAG_RED_WOLF ) )
	{
		return EIST_RedWolf;
	}
	else
	if( dm.ItemHasTag( itemName, theGame.params.ITEM_SET_TAG_VAMPIRE ) )
	{
		return EIST_Vampire;
	}
	else
	if( dm.ItemHasTag( itemName, theGame.params.ITEM_SET_TAG_VIPER ) )
	{
		return EIST_Viper;
	}

	else
	if( dm.ItemHasTag( itemName, 'NetflixSetMinor' ) )	//modSigns: ARM-15, the lower tiers keep NetflixSet (the dye rule, set items)
	{	//modSigns
		return EIST_Netflix_Minor;	//modSigns
	}	//modSigns
	else	//modSigns
	if( dm.ItemHasTag( itemName, theGame.params.ITEM_SET_TAG_NETFLIX ) )
	{
		return EIST_Netflix;
	}
	else	//modSigns
	if( dm.ItemHasTag( itemName, 'KaerMorhenSet' ) )	//modSigns
	{	//modSigns
		return EIST_KaerMorhen;	//modSigns
	}	//modSigns
	else	//modSigns
	if( dm.ItemHasTag( itemName, 'LynxSetMinor' ) )	//modSigns
	{	//modSigns
		return EIST_Lynx_Minor;	//modSigns
	}	//modSigns
	else	//modSigns
	if( dm.ItemHasTag( itemName, 'GryphonSetMinor' ) )	//modSigns
	{	//modSigns
		return EIST_Gryphon_Minor;	//modSigns
	}	//modSigns
	else	//modSigns
	if( dm.ItemHasTag( itemName, 'BearSetMinor' ) )	//modSigns
	{	//modSigns
		return EIST_Bear_Minor;	//modSigns
	}	//modSigns
	else	//modSigns
	if( dm.ItemHasTag( itemName, 'WolfSetMinor' ) )	//modSigns
	{	//modSigns
		return EIST_Wolf_Minor;	//modSigns
	}	//modSigns
	else	//modSigns
	{
		return EIST_Undefined;
	}
}

// ARM-05: the minor tiers and Kaer Morhen.
@replaceMethod(W3PlayerWitcher)
function CheckSetType( item : SItemUniqueId ) : EItemSetType
{
	var stopLoop 	: bool;
	var tags 		: array<name>;
	var i 			: int;
	var setType 	: EItemSetType;

	stopLoop = false;

	inv.GetItemTags( item, tags );
	if( tags.Contains( 'NetflixSetMinor' ) )	//modSigns: ARM-15, before the NetflixSet tag the lower tiers keep
		return EIST_Netflix_Minor;	//modSigns

	for( i=0; i<tags.Size(); i+=1 )
	{
		switch( tags[i] )
		{
			case theGame.params.ITEM_SET_TAG_LYNX:
			case theGame.params.ITEM_SET_TAG_GRYPHON:
			case theGame.params.ITEM_SET_TAG_BEAR:
			case theGame.params.ITEM_SET_TAG_WOLF:
			case theGame.params.ITEM_SET_TAG_RED_WOLF:
			case theGame.params.ITEM_SET_TAG_VAMPIRE:

			case theGame.params.ITEM_SET_TAG_VIPER:
			case theGame.params.ITEM_SET_TAG_NETFLIX:
			case 'KaerMorhenSet':	//modSigns
			case 'LynxSetMinor':	//modSigns
			case 'GryphonSetMinor':	//modSigns
			case 'BearSetMinor':	//modSigns
			case 'WolfSetMinor':	//modSigns
				setType = SetItemNameToType( tags[i] );
				stopLoop = true;
				break;
		}
		if ( stopLoop )
		{
			break;
		}
	}

	return setType;
}

// ARM-05: tier 1 is active with the pieces of every tier.
@replaceMethod(W3PlayerWitcher)
function SetBonusStatusByType(setType : EItemSetType, out desc1, desc2 : string, out isActive1, isActive2 : bool):void
{
	var setBonus : EItemSetBonus;

	if( GetSetPartsEquipped( setType ) >= GMGetNumItemsRequiredForSetActivation( setType ) )	//modSigns
	{
		isActive1 = true;
	}

	if( amountOfSetPiecesEquipped[ setType ] >= theGame.params.ITEMS_REQUIRED_FOR_MAJOR_SET_BONUS )
	{
		isActive2 = true;
	}

	setBonus = ItemSetTypeToItemSetBonus( setType, 1 );
	desc1 = GetSetBonusTooltipDescription( setBonus );

	setBonus = ItemSetTypeToItemSetBonus( setType, 2 );
	desc2 = GetSetBonusTooltipDescription( setBonus );
}

// ARM-05: the minor tiers have the set's first bonus only; Viper and Kaer Morhen one bonus.
@replaceMethod(W3PlayerWitcher)
function ItemSetTypeToItemSetBonus( setType : EItemSetType, nr : int ) : EItemSetBonus
{
	var setBonus : EItemSetBonus;

	if( nr == 1 )
	{
		switch( setType )
		{
			case EIST_Lynx: 			setBonus = EISB_Lynx_1;		break;
			case EIST_Gryphon: 			setBonus = EISB_Gryphon_1;	break;
			case EIST_Bear: 			setBonus = EISB_Bear_1;		break;
			case EIST_Wolf: 			setBonus = EISB_Wolf_1;		break;
			case EIST_RedWolf: 			setBonus = EISB_RedWolf_1;	break;
			case EIST_Vampire:			setBonus = EISB_Vampire;	break;

			case EIST_Netflix:			setBonus = EISB_Netflix_1;	break;
			case EIST_Viper:			setBonus = EISB_Viper;		break;	//modSigns
			case EIST_KaerMorhen:		setBonus = EISB_KaerMorhen;	break;	//modSigns
			case EIST_Lynx_Minor:		setBonus = EISB_Lynx_1;		break;	//modSigns
			case EIST_Gryphon_Minor:	setBonus = EISB_Gryphon_1;	break;	//modSigns
			case EIST_Bear_Minor:		setBonus = EISB_Bear_1;		break;	//modSigns
			case EIST_Wolf_Minor:		setBonus = EISB_Wolf_1;		break;	//modSigns
			case EIST_Netflix_Minor:	setBonus = EISB_Netflix_1;	break;	//modSigns: ARM-15
		}
	}
	else
	{
		switch( setType )
		{
			case EIST_Lynx: 			setBonus = EISB_Lynx_2;		break;
			case EIST_Gryphon: 			setBonus = EISB_Gryphon_2;	break;
			case EIST_Bear: 			setBonus = EISB_Bear_2;		break;
			case EIST_Wolf: 			setBonus = EISB_Wolf_2;		break;
			case EIST_RedWolf: 			setBonus = EISB_RedWolf_2;	break;
			case EIST_Vampire:			setBonus = EISB_Undefined;	break;

			case EIST_Netflix:			setBonus = EISB_Netflix_2;	break;
			default:					setBonus = EISB_Undefined;	break;	//modSigns: Viper, Kaer Morhen, minor tiers
		}
	}

	return setBonus;
}

// ARM-05: sound banks follow the pieces of every tier.
@replaceMethod(W3PlayerWitcher)
function ManageSetBonusesSoundbanks( setType : EItemSetType )
{
	if( GetSetPartsEquipped( setType ) >= GMGetNumItemsRequiredForSetActivation( setType ) )	//modSigns
	{
		switch( setType )
		{
			case EIST_Lynx:
			case EIST_Lynx_Minor:	//modSigns
				LoadSetBonusSoundBank( "ep2_setbonus_lynx.bnk" );
				break;
			case EIST_Gryphon:
			case EIST_Gryphon_Minor:	//modSigns
				LoadSetBonusSoundBank( "ep2_setbonus_gryphon.bnk" );
				break;
			case EIST_Bear:
			case EIST_Bear_Minor:	//modSigns
				LoadSetBonusSoundBank( "ep2_setbonus_bear.bnk" );
				break;
		}
	}
	else
	{
		switch( setType )
		{
			case EIST_Lynx:
			case EIST_Lynx_Minor:	//modSigns
				UnloadSetBonusSoundBank( "ep2_setbonus_lynx.bnk" );
				break;
			case EIST_Gryphon:
			case EIST_Gryphon_Minor:	//modSigns
				UnloadSetBonusSoundBank( "ep2_setbonus_gryphon.bnk" );
				break;
			//modSigns: removed the Bear bank's unloading: it stays loaded for Quen Discharge's Bear effects (ARM-08, audit F6)
		}
	}
}

// ARM-05: the set pieces recounted and the set sound banks loaded at every load (legacy loaded the
// banks at spawn and recounted once on old saves). The Bear set's bank is always loaded: Quen
// Discharge plays the Bear set's effects (ARM-08; legacy's LoadCurrentSetBonusSoundbank, audit F6).
@wrapMethod(W3PlayerWitcher)
function OnSpawned(spawnData : SEntitySpawnData)
{
	wrappedMethod(spawnData);
	GMRecalcSetItemsEquipped();
	LoadSetBonusSoundBank( "ep2_setbonus_bear.bnk" );
	((W3PlayerAbilityManager)abilityManager).GMManageSetArmorTypeBonus();	// ARM-04: the generic set's bonus checked at every load
}

// ARM-05: the set bonus abilities, legacy's entries added with each set's slice (ARM-09: Wolven tier 2;
// ARM-10: Manticore tier 1; ARM-15: the Netflix set's values).
// 5.x body; changes marked //modSigns.
@replaceMethod
function GetSetBonusAbility( setBonus : EItemSetBonus ) : name
{
	switch( setBonus )
	{
		case EISB_Lynx_2:				return 'setBonusAbilityLynx_2';
		case EISB_Bear_1:				return 'setBonusAbilityBear_1';
		case EISB_Bear_2:				return 'setBonusAbilityBear_2';
		case EISB_RedWolf_1:			return 'setBonusAbilityRedWolf_1';	//modSigns: ARM-10
		case EISB_RedWolf_2:			return 'setBonusAbilityRedWolf_2';
		case EISB_Wolf_1:				return 'SetBonusAbilityWolf_1';
		case EISB_Wolf_2:				return 'SetBonusAbilityWolf_2';	//modSigns: ARM-09
		case EISB_Netflix_1:			return 'SetBonusAbilityNetflix_1';
		case EISB_Netflix_2:			return 'SetBonusAbilityNetflix_2';	//modSigns: ARM-15
		default: 						return '';
	}
}

// ARM-05 (audit F5): the Fully Armed achievement as legacy: a full set of lower-tier school pieces
// counts, the school crossbow is not needed, Viper is left out; 5.x's Netflix set and its progress
// notice per set kept.
// 5.x body; changes marked //modSigns.
@replaceMethod(W3PlayerWitcher)
function CheckForFullyArmedAchievement()
{
	if( HasAllItemsFromSet(theGame.params.ITEM_SET_TAG_BEAR) || HasAllItemsFromSet(theGame.params.ITEM_SET_TAG_GRYPHON) ||
		HasAllItemsFromSet(theGame.params.ITEM_SET_TAG_LYNX) || HasAllItemsFromSet(theGame.params.ITEM_SET_TAG_WOLF) ||
		HasAllItemsFromSet('BearSetMinor') || HasAllItemsFromSet('GryphonSetMinor') ||	//modSigns
		HasAllItemsFromSet('LynxSetMinor') || HasAllItemsFromSet('WolfSetMinor') ||	//modSigns
		//modSigns: removed Viper (legacy)
		HasAllItemsFromSet(theGame.params.ITEM_SET_TAG_NETFLIX)	//modSigns
	)
	{
		theGame.GetGamerProfile().AddAchievement(EA_FullyArmed);
	}
}

// ARM-05 (audit F5): no school crossbow needed (legacy).
// 5.x body; changes marked //modSigns.
@replaceMethod(W3PlayerWitcher)
function HasAllItemsFromSet(setItemTag : name) : bool
{
	var item : SItemUniqueId;

	if(!GetItemEquippedOnSlot(EES_SteelSword, item) || !inv.ItemHasTag(item, setItemTag))
		return false;

	if(!GetItemEquippedOnSlot(EES_SilverSword, item) || !inv.ItemHasTag(item, setItemTag))
		return false;

	if(!GetItemEquippedOnSlot(EES_Boots, item) || !inv.ItemHasTag(item, setItemTag))
		return false;

	if(!GetItemEquippedOnSlot(EES_Pants, item) || !inv.ItemHasTag(item, setItemTag))
		return false;

	if(!GetItemEquippedOnSlot(EES_Gloves, item) || !inv.ItemHasTag(item, setItemTag))
		return false;

	if(!GetItemEquippedOnSlot(EES_Armor, item) || !inv.ItemHasTag(item, setItemTag))
		return false;

	//modSigns: removed the crossbow for the Bear and Feline sets (legacy)

	return true;
}

// ARM-05 (audit F5): 5.x's progress check on equip, with lower-tier sets, no crossbow and no Viper
// (legacy's rules).
// 5.x body; changes marked //modSigns.
@replaceMethod(W3PlayerWitcher)
function CheckForFullyArmedByTag(setItemTag : name)
{
	var doneParts, totalParts : int;
	var item : SItemUniqueId;

	if(setItemTag == '' || setItemTag == theGame.params.ITEM_SET_TAG_VIPER)	//modSigns: no Viper (legacy)
		return;


	doneParts = 0;
	totalParts = 6;
	if(GetItemEquippedOnSlot(EES_SteelSword, item) && inv.ItemHasTag(item, setItemTag))
		doneParts += 1;

	if(GetItemEquippedOnSlot(EES_SilverSword, item) && inv.ItemHasTag(item, setItemTag))
		doneParts += 1;

	if(GetItemEquippedOnSlot(EES_Boots, item) && inv.ItemHasTag(item, setItemTag))
		doneParts += 1;

	if(GetItemEquippedOnSlot(EES_Pants, item) && inv.ItemHasTag(item, setItemTag))
		doneParts += 1;

	if(GetItemEquippedOnSlot(EES_Gloves, item) && inv.ItemHasTag(item, setItemTag))
		doneParts += 1;

	if(GetItemEquippedOnSlot(EES_Armor, item) && inv.ItemHasTag(item, setItemTag))
		doneParts += 1;

	//modSigns: removed the crossbow for the Bear and Feline sets (legacy)

	if(doneParts >= totalParts)
	{
		theGame.GetGamerProfile().AddAchievement(EA_FullyArmed);
	}
	else
	{
		theGame.GetGamerProfile().NoticeAchievementProgress(EA_FullyArmed, doneParts, totalParts);
	}
}

// ARM-05 (audit F5): the lower tiers' set tags, so equipping them reports the achievement's progress.
// 5.x body; changes marked //modSigns.
@replaceMethod(CInventoryComponent)
function DetectTagOfASet(item : SItemUniqueId) : name
{
	if (ItemHasTag(item, theGame.params.ITEM_SET_TAG_BEAR) )
		return theGame.params.ITEM_SET_TAG_BEAR;
	if (ItemHasTag(item, theGame.params.ITEM_SET_TAG_GRYPHON) )
		return theGame.params.ITEM_SET_TAG_GRYPHON;
	if (ItemHasTag(item, theGame.params.ITEM_SET_TAG_LYNX) )
		return theGame.params.ITEM_SET_TAG_LYNX;
	if (ItemHasTag(item, theGame.params.ITEM_SET_TAG_WOLF) )
		return theGame.params.ITEM_SET_TAG_WOLF;
	if (ItemHasTag(item, theGame.params.ITEM_SET_TAG_RED_WOLF) )
		return theGame.params.ITEM_SET_TAG_RED_WOLF;
	if (ItemHasTag(item, theGame.params.ITEM_SET_TAG_VAMPIRE) )
		return theGame.params.ITEM_SET_TAG_VAMPIRE;
	if (ItemHasTag(item, theGame.params.ITEM_SET_TAG_VIPER) )
		return theGame.params.ITEM_SET_TAG_VIPER;
	if (ItemHasTag(item, 'BearSetMinor') )	//modSigns
		return 'BearSetMinor';	//modSigns
	if (ItemHasTag(item, 'GryphonSetMinor') )	//modSigns
		return 'GryphonSetMinor';	//modSigns
	if (ItemHasTag(item, 'LynxSetMinor') )	//modSigns
		return 'LynxSetMinor';	//modSigns
	if (ItemHasTag(item, 'WolfSetMinor') )	//modSigns
		return 'WolfSetMinor';	//modSigns

	if (ItemHasTag(item, theGame.params.ITEM_SET_TAG_NETFLIX) )
		return theGame.params.ITEM_SET_TAG_NETFLIX;

	return '';
}
