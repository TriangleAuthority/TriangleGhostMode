// ARM-15: the Netflix set ("Forgotten Wolven", 5.x only) under Ghost Mode's rules, the owner's decision
// DA3 (docs/features/arm.md):
// - every tier counts towards the first bonus: the lower tiers are tagged `NetflixSetMinor` and
//   counted under EIST_Netflix_Minor (armor/setFramework.ws; items generated by tools/gen_arm_new.py);
// - 3 pieces: potions (not decoctions) last 7% longer per piece (skills/brewing.ws);
// - 6 grandmaster pieces: +0.5 sign intensity for every sign effect against enemies inside Geralt's
//   Yrden, except Yrden's own slow and shock; 5.x's Aard damage against them is gone (damage/pool.ws).
//   The bonus is added where a sign's power is read for its target: the damage action's power stat
//   (damage, effect chances and the power effects carry: knockdowns, burning, Quen's shock, Mutation
//   2's crits), Igni's Melt Armor and Firestream (skills/igni.ws) and Axii's per-target power
//   (skills/axii.ws).

// The potion duration per piece (setBonusAbility of tier 1).
function GMNetflixPotionDurationPerPiece() : float
{
	var min, max : SAbilityAttributeValue;

	theGame.GetDefinitionsManager().GetAbilityAttributeValue(GetSetBonusAbility(EISB_Netflix_1), 'per_piece_potion_duration', min, max);
	return CalculateAttributeValue(min);
}

// The intensity bonus of tier 2 (setBonusAbility of tier 2).
function GMNetflixYrdenIntensityBonus() : float
{
	var min, max : SAbilityAttributeValue;

	theGame.GetDefinitionsManager().GetAbilityAttributeValue(GetSetBonusAbility(EISB_Netflix_2), 'yrden_target_spell_power', min, max);
	return CalculateAttributeValue(min);
}

// Whether the victim is inside one of Geralt's Yrden traps (normal or alternate).
@addMethod(W3PlayerWitcher)
public function GMIsInsideOwnYrden(victim : CActor) : bool
{
	var i : int;

	for(i = 0; i < yrdenEntities.Size(); i += 1)
		if(yrdenEntities[i] && yrdenEntities[i].validTargetsInArea.Contains(victim))
			return true;
	return false;
}

// The intensity a sign of the caster's gains against the victim: tier 2 of the Netflix set, the victim
// inside Geralt's Yrden, any sign but Yrden.
function GMNetflixYrdenIntensity(caster : CActor, victim : CActor, signSkill : ESkill) : float
{
	var witcher : W3PlayerWitcher;

	witcher = (W3PlayerWitcher)caster;
	if(!witcher || !victim || victim == caster || !witcher.IsSetBonusActive(EISB_Netflix_2))
		return 0;
	if(signSkill == S_Magic_3 || signSkill == S_Magic_s03)
		return 0;
	if(!witcher.GMIsInsideOwnYrden(victim))
		return 0;
	return GMNetflixYrdenIntensityBonus();
}

// A sign action's power against its victim (every damage action of a sign: its damage, the chances and
// power of its effects).
@wrapMethod(W3DamageAction)
function GetPowerStatValue() : SAbilityAttributeValue
{
	var result : SAbilityAttributeValue;
	var signEntity : W3SignEntity;
	var signProjectile : W3SignProjectile;

	result = wrappedMethod();
	if(powerStatType != CPS_Undefined && (W3PlayerWitcher)attacker)
	{
		signEntity = (W3SignEntity)causer;
		signProjectile = (W3SignProjectile)causer;
		if(!signEntity && signProjectile)
			signEntity = signProjectile.GetSignEntity();
		if(signEntity)
			result.valueMultiplicative += GMNetflixYrdenIntensity((CActor)attacker, (CActor)victim, signEntity.GetSkill());
	}
	return result;
}
