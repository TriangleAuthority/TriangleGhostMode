// ARM-12: the Kaer Morhen set as legacy: a 4-piece medium set made from the starting armor (renamed
// "Worn Kaer Morhen ..."), upgraded at levels 2, 9, 19 and 27; its schematics are known from the start
// (granted once at load, fact gm_km_schematics_added); with 3 pieces, stamina regen +1 per second for
// each additional hostile enemy within 30 m (up to +5), recounted every second while in combat. The items,
// abilities and schematics are generated by tools/gen_arm_km.py (items/gm_arm_kaer_morhen.xml); the new
// game's first armor schematic is "Kaer Morhen Armor schematic" (legacy repurposed 5.x's "Starting
// Armor Upgrade schematic 1", which a DLC cannot override). 5.x's schematic is never taught and is
// removed from saves at load, so the starting armor upgrades only to Kaer Morhen armor, as legacy (the
// owner's decision, 2026-10-17). New Game+ replaces the pieces with their NG+ items (legacy). See
// docs/features/arm.md.

class W3GMEffect_KaerMorhenSetBonus extends CBaseGameplayEffect
{
	default effectType = EET_GMKaerMorhenSetBonus;
	default isPositive = true;
	default dontAddAbilityOnTarget = true;

	var gmUpdateInterval : float;	default gmUpdateInterval = 1.0f;
	var gmTimeInterval : float;	default gmTimeInterval = 0.0f;
	var gmMaxStacks : int;

	event OnEffectAdded( customParams : W3BuffCustomParams )
	{
		var min, max : SAbilityAttributeValue;

		super.OnEffectAdded( customParams );
		theGame.GetDefinitionsManager().GetAbilityAttributeValue(abilityName, 'maxStacks', min, max);
		gmMaxStacks = RoundMath(min.valueAdditive);
	}

	event OnEffectRemoved()
	{
		super.OnEffectRemoved();
		thePlayer.RemoveAbilityAll(abilityName);
	}

	event OnUpdate(dt : float)
	{
		super.OnUpdate(dt);
		gmTimeInterval += dt;
		if(gmTimeInterval >= gmUpdateInterval)
		{
			gmTimeInterval -= gmUpdateInterval;
			GMRecount();
		}
	}

	// The regen abilities on Geralt: one per hostile enemy beyond the first, up to the maximum.
	public function GMRecount()
	{
		var numEnemies, abilityCount : int;

		numEnemies = Clamp(GetWitcherPlayer().GMGetNumHostilesInRange() - 1, 0, gmMaxStacks);
		abilityCount = thePlayer.GetAbilityCount(abilityName);
		if(numEnemies > abilityCount)
			thePlayer.AddAbilityMultiple(abilityName, numEnemies - abilityCount);
		else if(numEnemies < abilityCount)
			thePlayer.RemoveAbilityMultiple(abilityName, abilityCount - numEnemies);
	}
}

// The set's schematics, granted once (legacy: at spawn and on starting New Game+).
@addMethod(W3PlayerWitcher)
function GMAddKaerMorhenSchematics()
{
	var names : array<name>;
	var i : int;

	if(FactsQuerySum("gm_km_schematics_added") > 0)
		return;
	names.PushBack('Kaer Morhen Armor schematic');
	names.PushBack('Kaer Morhen Armor 1 schematic'); names.PushBack('Kaer Morhen Armor 2 schematic'); names.PushBack('Kaer Morhen Armor 3 schematic');
	names.PushBack('Kaer Morhen Pants schematic'); names.PushBack('Kaer Morhen Pants 1 schematic'); names.PushBack('Kaer Morhen Pants 2 schematic'); names.PushBack('Kaer Morhen Pants 3 schematic');
	names.PushBack('Kaer Morhen Boots schematic'); names.PushBack('Kaer Morhen Boots 1 schematic'); names.PushBack('Kaer Morhen Boots 2 schematic'); names.PushBack('Kaer Morhen Boots 3 schematic');
	names.PushBack('Kaer Morhen Gloves schematic'); names.PushBack('Kaer Morhen Gloves 1 schematic'); names.PushBack('Kaer Morhen Gloves 2 schematic'); names.PushBack('Kaer Morhen Gloves 3 schematic');
	for(i = 0; i < names.Size(); i += 1)
		AddCraftingSchematic(names[i], true, true);
	FactsAdd("gm_km_schematics_added");
}

// The set's effect follows the set while in combat.
@addMethod(W3PlayerWitcher)
function GMManageKaerMorhenSetBonus()
{
	if(!IsSetBonusActive(EISB_KaerMorhen))
		RemoveBuff(EET_GMKaerMorhenSetBonus);
	else if(IsInCombat() && !HasBuff(EET_GMKaerMorhenSetBonus))
		AddEffectDefault(EET_GMKaerMorhenSetBonus, this, "KaerMorhenSetBonus");
}

// Load: the schematics (5.x's first starting armor upgrade gone); no effect left from a save (legacy
// removed it at spawn).
@wrapMethod(W3PlayerWitcher)
function OnSpawned(spawnData : SEntitySpawnData)
{
	wrappedMethod(spawnData);
	RemoveBuff(EET_GMKaerMorhenSetBonus);
	GMAddKaerMorhenSchematics();
	GMRemoveStartingArmorUpgradeSchematic();
}

// 5.x's "Starting Armor Upgrade schematic 1" (Starting Armor to 5.x's Starting Armor 1) is never taught:
// 5.x teaches it at every spawn, and any other source (a quest, a schematic item read) goes through here.
@wrapMethod(W3PlayerWitcher)
function AddCraftingSchematic( nam : name, optional isSilent : bool, optional skipTutorialUpdate : bool ) : bool
{
	if(nam == GMStartingArmorUpgradeSchematic())
		return false;
	return wrappedMethod(nam, isSilent, skipTutorialUpdate);
}

// A save that knows it forgets it (Starting Armor 1 already made stays).
@addMethod(W3PlayerWitcher)
function GMRemoveStartingArmorUpgradeSchematic()
{
	craftingSchematics.Remove(GMStartingArmorUpgradeSchematic());
}

function GMStartingArmorUpgradeSchematic() : name
{
	return 'Starting Armor Upgrade schematic 1';
}

@wrapMethod(W3PlayerWitcher)
function OnCombatStart()
{
	wrappedMethod();
	GMManageKaerMorhenSetBonus();
}

@wrapMethod(W3PlayerWitcher)
function OnCombatFinished()
{
	var ret : bool;

	ret = wrappedMethod();
	RemoveBuff(EET_GMKaerMorhenSetBonus);
	return ret;
}

// New Game+: the set's pieces become their NG+ items, and the schematics are granted (legacy).
@wrapMethod(W3PlayerWitcher)
function NewGamePlusInitialize()
{
	var horseInv : CInventoryComponent;

	wrappedMethod();
	GMNewGamePlusReplaceKaerMorhenSet(inv);
	horseInv = GetHorseManager().GetInventoryComponent();
	if(horseInv)
		GMNewGamePlusReplaceKaerMorhenSet(horseInv);
	GMAddKaerMorhenSchematics();
}

@addMethod(W3PlayerWitcher)
function GMNewGamePlusReplaceKaerMorhenSet(out invComp : CInventoryComponent)
{
	var i : int;

	for(i = 0; i < 16; i += 1)
		NewGamePlusReplaceItem(GMKaerMorhenPieceName(i, false), GMKaerMorhenPieceName(i, true), invComp);
}

// The i-th piece name (armor, pants, boots, gloves; tiers 0 to 3), or its NG+ item.
function GMKaerMorhenPieceName(i : int, ngp : bool) : name
{
	var names, ngpNames : array<name>;

	names.PushBack('Kaer Morhen Armor'); names.PushBack('Kaer Morhen Armor 1'); names.PushBack('Kaer Morhen Armor 2'); names.PushBack('Kaer Morhen Armor 3');
	names.PushBack('Kaer Morhen Pants'); names.PushBack('Kaer Morhen Pants 1'); names.PushBack('Kaer Morhen Pants 2'); names.PushBack('Kaer Morhen Pants 3');
	names.PushBack('Kaer Morhen Boots'); names.PushBack('Kaer Morhen Boots 1'); names.PushBack('Kaer Morhen Boots 2'); names.PushBack('Kaer Morhen Boots 3');
	names.PushBack('Kaer Morhen Gloves'); names.PushBack('Kaer Morhen Gloves 1'); names.PushBack('Kaer Morhen Gloves 2'); names.PushBack('Kaer Morhen Gloves 3');
	ngpNames.PushBack('NGP Kaer Morhen Armor'); ngpNames.PushBack('NGP Kaer Morhen Armor 1'); ngpNames.PushBack('NGP Kaer Morhen Armor 2'); ngpNames.PushBack('NGP Kaer Morhen Armor 3');
	ngpNames.PushBack('NGP Kaer Morhen Pants'); ngpNames.PushBack('NGP Kaer Morhen Pants 1'); ngpNames.PushBack('NGP Kaer Morhen Pants 2'); ngpNames.PushBack('NGP Kaer Morhen Pants 3');
	ngpNames.PushBack('NGP Kaer Morhen Boots'); ngpNames.PushBack('NGP Kaer Morhen Boots 1'); ngpNames.PushBack('NGP Kaer Morhen Boots 2'); ngpNames.PushBack('NGP Kaer Morhen Boots 3');
	ngpNames.PushBack('NGP Kaer Morhen Gloves'); ngpNames.PushBack('NGP Kaer Morhen Gloves 1'); ngpNames.PushBack('NGP Kaer Morhen Gloves 2'); ngpNames.PushBack('NGP Kaer Morhen Gloves 3');
	if(ngp)
		return ngpNames[i];
	return names[i];
}

// The most extra enemies the set counts.
function GMKaerMorhenMaxStacks() : float
{
	var min, max : SAbilityAttributeValue;

	theGame.GetDefinitionsManager().GetAbilityAttributeValue('GMKaerMorhenSetBonusEffect', 'maxStacks', min, max);
	return CalculateAttributeValue(min);
}
