<?xml version="1.0" encoding="UTF-8"?>
<!-- New Game+ copy of abilities/gm_damage.xml, generated by tools/gen_ngplus.py: numbers scaled by the NG+ rule (docs/feature-mapping.md). Do not edit by hand. -->
<!-- Ghost Mode: the damage formula's data (DMG). -->
<redxml>
  <definitions>
    <abilities>
      <!-- DMG-04, Strong Attack's core rule: heavy attacks add +50% weapon damage (the pool,
           heavy_attack_dmg_boost) and pierce 200 armor (vanilla 1000), with no attack power bonus
           (vanilla +0.333, which offset vanilla's heavy attack penalty). -->
      <ability name="sword_2" on_conflict="replace">
        <tags>sword_2,attack_heavy</tags>
        <armor_reduction type="add" min="200" max="200" />
        <heavy_attack_dmg_boost type="mult" min="0.5" />
      </ability>
      <!-- DMG-01: heavy and special attacks get no attack power bonus (vanilla +0.15 to +0.5): heavy
           attacks add +25% weapon damage to NPCs' pool instead (DMG-04). The attack names are shared
           by Geralt and NPCs. -->
      <ability name="attack_heavy" on_conflict="extend">
        <attack_power type="mult" always_random="false" min="0" max="0" />
      </ability>
      <ability name="attack_heavy_special" on_conflict="extend">
        <attack_power type="mult" always_random="false" min="0" max="0" />
      </ability>
      <!-- attack_heavy_noparry is a Hearts of Stone ability: extend empties it (development.md), so it is
           given whole, as legacy's: no attack power bonus (DMG-01), no focus_gain (SKL-07), the tag and
           focus_hit_drain_mod kept. -->
      <ability name="attack_heavy_noparry" on_conflict="replace">
        <tags>attack_heavy</tags>
        <attack_power type="mult" always_random="false" min="0" max="0" />
        <focus_hit_drain_mod type="mult" always_random="false" min="1.5" max="1.5" />
      </ability>
      <ability name="attack_heavy_knockdown" on_conflict="extend">
        <attack_power type="mult" always_random="false" min="0" max="0" />
      </ability>
      <ability name="attack_heavy_stagger" on_conflict="extend">
        <attack_power type="mult" always_random="false" min="0" max="0" />
      </ability>
      <ability name="attack_super_heavy" on_conflict="extend">
        <attack_power type="mult" always_random="false" min="0" max="0" />
      </ability>
      <ability name="bleeding_light" on_conflict="extend">
        <attack_power type="mult" always_random="false" min="0" max="0" />
      </ability>
      <!-- DMG-02: registers the stats Ghost Mode's resistance model reads: the point values of will
           and burning resistance, and the damage-over-time resistances for NPCs (legacy). -->
      <ability name="all_NPC_ability" on_conflict="extend">
        <will_resistance type="mult" min="1" max="1" />
        <burning_resistance type="mult" min="1" max="1" />
        <burning_DoT_damage_resistance_perc type="mult" min="1" max="1" />
        <poison_DoT_damage_resistance_perc type="mult" min="1" max="1" />
        <bleeding_DoT_damage_resistance_perc type="mult" min="1" max="1" />
      </ability>
      <ability name="all_PC_ability" on_conflict="extend">
        <will_resistance type="mult" min="1" max="1" />
        <burning_resistance type="mult" min="1" max="1" />
      </ability>
    </abilities>
  </definitions>
</redxml>
