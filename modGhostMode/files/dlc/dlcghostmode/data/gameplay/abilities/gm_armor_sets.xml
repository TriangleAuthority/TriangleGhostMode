<?xml version="1.0" encoding="UTF-8"?>
<!-- Ghost Mode: the witcher set bonuses (ARM-06 to ARM-15), legacy's values. Blood and Wine's abilities are given whole (on_conflict="replace"): extend leaves expansion abilities without attributes. -->
<redxml>
  <definitions>
    <abilities>
      <!-- ARM-07: Griffin tier 1, any sign starts a 2.5 s buff: stamina costs -5% per piece (legacy) -->
      <ability name="GryphonSetBonusEffect" on_conflict="replace">
        <tags>setBonusAbilityGryphon_1</tags>
        <duration type="add" min="2.5" />
        <gryphon_tier1_bonus type="add" min="0.05" />
      </ability>
      <!-- ARM-07: Griffin tier 2, inside a normal Yrden: intensity +50%, +15% resistances, no regen, no damage reduction (legacy) -->
      <ability name="GryphonSetBonusYrdenEffect" on_conflict="replace">
        <tags>setBonusAbilityGryphon_2</tags>
        <duration type="add" min="-1" />
        <spell_power type="mult" min="0.5" />
        <slashing_resistance_perc type="add" min="0.15" />
        <piercing_resistance_perc type="add" min="0.15" />
        <bludgeoning_resistance_perc type="add" min="0.15" />
        <rending_resistance_perc type="add" min="0.15" />
        <elemental_resistance_perc type="add" min="0.15" />
        <force_resistance_perc type="add" min="0.15" />
        <shock_resistance_perc type="add" min="0.15" />
        <will_resistance_perc type="add" min="0.15" />
        <fire_resistance_perc type="add" min="0.15" />
        <frost_resistance_perc type="add" min="0.15" />
        <trigger_scale type="add" min="1.4" />
      </ability>
      <!-- ARM-08: Bear tier 1, adrenaline per piece on hits taken, attack power per piece per adrenaline point; tier 2, strong attacks give back 33.4% of their stamina (legacy; 5.x's Quen rules gone) -->
      <ability name="setBonusAbilityBear_1" on_conflict="replace">
        <tags>setBonusAbilityBear_1</tags>
        <bonus_focus_gain type="add" min="0.035" />
        <attack_power type="mult" min="0.035" />
      </ability>
      <ability name="setBonusAbilityBear_2" on_conflict="replace">
        <tags>setBonusAbilityBear_2</tags>
        <stamina_attack type="add" min="0.334" />
      </ability>
      <!-- ARM-06: Feline tier 1, a chain of fast hits: +2.5% attack power per piece per hit, up to +60%; tier 2 (sword crits double adrenaline) has no values (legacy) -->
      <ability name="LynxSetBonusEffect" on_conflict="replace">
        <tags>LynxSetBonusEffect</tags>
        <duration type="add" min="-1" />
        <lynx_ap_boost type="add" min="0.025" />
        <lynx_boost_max type="add" min="0.60" />
      </ability>
      <ability name="setBonusAbilityLynx_2" on_conflict="replace">
        <tags>setBonusAbilityLynx_2</tags>
      </ability>
      <!-- ARM-09: Wolven tier 1, oil effects +16.7% per piece; tier 2, up to three oils on a sword, each +5% crit chance and +10% crit damage (legacy; 5.x's bleeding rules gone) -->
      <ability name="SetBonusAbilityWolf_1" on_conflict="replace">
        <tags>SetBonusAbilityWolf_1</tags>
        <per_piece_oil_bonus type="add" min="0.167" />
      </ability>
      <ability name="SetBonusAbilityWolf_2" on_conflict="replace">
        <tags>SetBonusAbilityWolf_2</tags>
        <max_oils_count type="add" min="3" />
        <per_oil_crit_chance_bonus type="add" min="0.05" />
        <per_oil_crit_power_bonus type="add" min="0.10" />
      </ability>
      <!-- ARM-10: Manticore tier 1, bombs +5% crit chance and +10% crit damage per piece (legacy; a new ability: 5.x has none) -->
      <ability name="setBonusAbilityRedWolf_1">
        <tags>setBonusAbilityRedWolf_1</tags>
        <per_redwolf_piece_crit_chance_bonus type="add" min="0.05" />
        <per_redwolf_piece_crit_power_bonus type="add" min="0.10" />
      </ability>
      <!-- ARM-11: Viper, poison damage cancelled and 10% of it healed per piece (legacy; a new ability: 5.x has none) -->
      <ability name="setBonusAbilityViper_1">
        <tags>setBonusAbilityViper_1</tags>
        <per_viper_piece_poison_healing_rate type="add" min="0.1" />
      </ability>
      <!-- ARM-13: Tesham Mutna, damage dealt heals 0.5% of maximum Vitality per piece (legacy; 5.x: 1% per piece per kill) -->
      <ability name="setBonusAbilityVampire" on_conflict="replace">
        <tags>setBonusAbilityVampire</tags>
        <life_percent type="add" min="0.5" />
      </ability>
      <!-- ARM-15: Netflix (5.x only, DA3), potions only: +7% duration per piece of every tier (5.x: potions and decoctions, grandmaster pieces) -->
      <ability name="SetBonusAbilityNetflix_1">
        <tags>SetBonusAbilityNetflix_1</tags>
        <per_piece_potion_duration type="add" min="0.07" />
      </ability>
      <!-- ARM-15: Netflix tier 2 (DA3): +0.5 sign intensity against enemies inside Geralt's Yrden (5.x: Aard damage against them) -->
      <ability name="SetBonusAbilityNetflix_2">
        <tags>SetBonusAbilityNetflix_2</tags>
        <yrden_target_spell_power type="add" min="0.5" />
      </ability>
    </abilities>
  </definitions>
</redxml>
