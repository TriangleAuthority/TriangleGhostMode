<?xml version="1.0" encoding="UTF-8"?>
<!-- Ghost Mode: effect definitions for the mod's effects (STAM-01 sign cooldowns, STAM-02 Whirl and Rend cooldowns). -->
<redxml>
  <definitions>
    <abilities>
      <ability name="GMAardCooldownEffect">
        <duration type="add" min="-1" /> <!-- set in script -->
      </ability>
      <ability name="GMIgniCooldownEffect">
        <duration type="add" min="-1" /> <!-- set in script -->
      </ability>
      <ability name="GMYrdenCooldownEffect">
        <duration type="add" min="-1" /> <!-- set in script -->
      </ability>
      <ability name="GMQuenCooldownEffect">
        <duration type="add" min="-1" /> <!-- set in script -->
      </ability>
      <ability name="GMAxiiCooldownEffect">
        <duration type="add" min="-1" /> <!-- set in script -->
      </ability>
      <ability name="GMWhirlCooldownEffect">
        <duration type="add" min="-1" /> <!-- set in script -->
      </ability>
      <ability name="GMRendCooldownEffect">
        <duration type="add" min="-1" /> <!-- set in script -->
      </ability>
      <!-- SKL-07: Undying's 5 s of immortality and its cooldown (the skill's trigger_delay); the regen
           abilities are added once per skill level per whole adrenaline point (classic 1% of maximum
           Vitality per second, new tree 1.667%) -->
      <ability name="GMUndyingImmortalEffect">
        <duration type="add" min="5" />
      </ability>
      <ability name="GMUndyingCooldownEffect">
        <duration type="add" min="-1" /> <!-- set in script -->
      </ability>
      <!-- SKL-09: Melt Armor's debuff (15 s) and the stacks it adds, level x round(1 + 7 x intensity
           bonus): classic -2 armor and -0.2% resistances each, new tree 5/3 of that; Geralt's HUD timer -->
      <ability name="GMMeltArmorDebuffEffect">
        <duration type="add" min="15" />
      </ability>
      <ability name="GMMeltArmorTimerEffect">
        <duration type="add" min="15" />
      </ability>
      <ability name="GMMeltArmorDebuff">
        <armor type="add" min="-2" />
        <physical_resistance_perc type="add" min="-0.002" />
        <slashing_resistance_perc type="add" min="-0.002" />
        <piercing_resistance_perc type="add" min="-0.002" />
        <bludgeoning_resistance_perc type="add" min="-0.002" />
        <rending_resistance_perc type="add" min="-0.002" />
        <elemental_resistance_perc type="add" min="-0.002" />
      </ability>
      <ability name="GMMeltArmorDebuffNewTree">
        <armor type="add" min="-3.333333" />
        <physical_resistance_perc type="add" min="-0.003333" />
        <slashing_resistance_perc type="add" min="-0.003333" />
        <piercing_resistance_perc type="add" min="-0.003333" />
        <bludgeoning_resistance_perc type="add" min="-0.003333" />
        <rending_resistance_perc type="add" min="-0.003333" />
        <elemental_resistance_perc type="add" min="-0.003333" />
      </ability>
      <!-- SKL-08: a heavy knockdown lasts 5 s (5.x: 3 to 5 s at random; legacy, the finisher window) -->
      <ability name="HeavyKnockdownEffect" on_conflict="extend">
        <duration type="add" min="5" max="5" />
      </ability>
      <!-- SKL-09: Firestream's burning as the regular burning, 2.7% of maximum health per second for 3 s
           (5.x: 1% for 1 s) -->
      <ability name="BurningEffect_FireStream" on_conflict="extend">
        <FireDamage type="mult" min="0.027" max="0.027" />
        <duration type="add" min="3" max="3" />
      </ability>
      <!-- SKL-10: the slowdown's defaults 35% for 7.5 s (5.x: 50%, 10 s; Yrden's trap passes its own value) -->
      <ability name="SlowdownEffect" on_conflict="extend">
        <slowdown type="add" min="0.35" />
        <duration type="add" min="7.5" max="7.5" />
      </ability>
      <!-- SKL-12: confusion 3 s at the least (scripts lengthen it) and Geralt's +25% crit chance against the
           confused (read by skills/axii.ws; 5.x: 2 s, no bonus) -->
      <ability name="ConfusionEffect" on_conflict="extend">
        <duration type="add" min="3" max="3" />
        <critical_hit_chance type="add" min="0.25" />
      </ability>
      <!-- EFX-01: damage over time deals about the same total, as a share of maximum health: bleeding 1% per
           second for 8 s (5.x: 0.8% for 10 s; also the default of 5.x's inert Wolven BleedingEffect1 to 3) -->
      <ability name="BleedingEffect" on_conflict="extend">
        <DirectDamage type="mult" min="0.01" max="0.01" />
        <duration type="add" min="8" max="8" />
      </ability>
      <!-- EFX-01: a tracking bolt's bleeding 0.5% for 16 s (5.x: 0.1% for 30 s) -->
      <ability name="BleedingTrackingEffect" on_conflict="extend">
        <DirectDamage type="mult" min="0.005" max="0.005" />
        <duration type="add" min="16" max="16" />
      </ability>
      <!-- EFX-01: a broadhead bolt's bleeding 1% for 8 s (5.x: a flat 10 plus 0.1 to 0.2% for 10 s); given
           whole (replace): legacy removed the flat DirectDamage node -->
      <ability name="BleedingEffect_BroadheadBolt" on_conflict="replace">
        <DirectDamage type="mult" min="0.01" max="0.01" />
        <duration type="add" min="8" max="8" />
        <hp_regen_reduction_strength type="add" min="200" />
        <hp_regen_reduction_duration type="add" min="5" />
      </ability>
      <!-- EFX-01: the critical poison 1.6% for 5 s, as the plain poison (5.x: 2%) -->
      <ability name="PoisonCriticalEffect" on_conflict="extend">
        <PoisonDamage type="mult" min="0.016" max="0.016" />
      </ability>
      <!-- EFX-05: frost slowdown 7.5 s (5.x: 10 s), shortened by frost resistance (effects/slowdownFrost.ws);
           slowdown 0.35 (5.x: 0.5) carried though no script reads it: the slow is a fixed 30% -->
      <ability name="SlowdownFrostEffect" on_conflict="extend">
        <slowdown type="add" min="0.35" />
        <duration type="add" min="7.5" max="7.5" />
      </ability>
      <!-- EFX-05: hypnosis's default 5 s (5.x: 3 s; the fiend passes its own length) -->
      <ability name="HypnotizedEffect" on_conflict="extend">
        <duration type="add" min="5" max="5" />
      </ability>
      <!-- EFX-02: the generic freeze (Piercing Cold's and other freezes but Northern Wind's) 5 s (5.x: 4 s);
           the hit that shatters it deals +50% (5.x: 0, its knockdown instead; damage/pool.ws) -->
      <ability name="FrozenEffect" on_conflict="extend">
        <duration type="add" min="5" max="5" />
        <hpPercDamageBonusPerHit type="add" min="0.5" />
      </ability>
      <ability name="GMUndyingRegen">
        <vitalityRegen type="mult" min="0.01" max="0.01" />
        <vitalityCombatRegen type="mult" min="0.01" max="0.01" />
      </ability>
      <ability name="GMUndyingRegenNewTree">
        <vitalityRegen type="mult" min="0.016667" max="0.016667" />
        <vitalityCombatRegen type="mult" min="0.016667" max="0.016667" />
      </ability>
      <!-- MUT-10: Mutated Skin's damage over time (damage and duration set by the script) -->
      <ability name="GMMutation5Effect">
        <DirectDamage type="add" min="1" max="1" />
        <duration type="add" min="1" max="1" />
      </ability>
      <!-- MUT-12: the Mutation Catalyst's potion effect (it only starts Life Leech) -->
      <ability name="GMMutationTriggerEffect">
        <duration type="add" min="0.01" />
      </ability>
      <!-- ARM-12: the Kaer Morhen set: +1 stamina regen per additional enemy, up to 5 (the effect adds the ability once per enemy) -->
      <ability name="GMKaerMorhenSetBonusEffect">
        <tags>GMKaerMorhenSetBonusEffect</tags>
        <duration type="add" min="-1" />
        <staminaRegen type="add" min="1" />
        <maxStacks type="add" min="5" />
      </ability>
      <!-- ENCH-05: Invigoration's bonus (legacy's Runeword4Effect; the bonus is in the script) -->
      <ability name="GMRuneword4Effect">
        <duration type="add" min="-1" />
      </ability>
      <!-- ENCH-09: Prolongation's bonus (legacy's Runeword11Effect; the bonus is in the script) -->
      <ability name="GMRuneword11Effect">
        <duration type="add" min="-1" />
      </ability>
    </abilities>
  </definitions>
  <custom>
    <effects>
      <effect name_name="GMAardCooldownEffect" defaultAbilityName_name="GMAardCooldownEffect" iconType_name="GMAardCooldown" showOnHUD="1" effectNameLocalisationKey_name="effect_aard_cooldown" />
      <effect name_name="GMIgniCooldownEffect" defaultAbilityName_name="GMIgniCooldownEffect" iconType_name="GMIgniCooldown" showOnHUD="1" effectNameLocalisationKey_name="effect_igni_cooldown" />
      <effect name_name="GMYrdenCooldownEffect" defaultAbilityName_name="GMYrdenCooldownEffect" iconType_name="GMYrdenCooldown" showOnHUD="1" effectNameLocalisationKey_name="effect_yrden_cooldown" />
      <effect name_name="GMQuenCooldownEffect" defaultAbilityName_name="GMQuenCooldownEffect" iconType_name="GMQuenCooldown" showOnHUD="1" effectNameLocalisationKey_name="effect_quen_cooldown" />
      <effect name_name="GMAxiiCooldownEffect" defaultAbilityName_name="GMAxiiCooldownEffect" iconType_name="GMAxiiCooldown" showOnHUD="1" effectNameLocalisationKey_name="effect_axii_cooldown" />
      <effect name_name="GMWhirlCooldownEffect" defaultAbilityName_name="GMWhirlCooldownEffect" iconType_name="GMWhirlCooldown" showOnHUD="1" effectNameLocalisationKey_name="effect_whirl_cooldown" />
      <effect name_name="GMRendCooldownEffect" defaultAbilityName_name="GMRendCooldownEffect" iconType_name="GMRendCooldown" showOnHUD="1" effectNameLocalisationKey_name="effect_rend_cooldown" />
      <effect name_name="GMMeltArmorTimerEffect" defaultAbilityName_name="GMMeltArmorTimerEffect" iconType_name="GMMeltArmorTimer" showOnHUD="1" effectNameLocalisationKey_name="effect_melt_armor_timer" />
      <effect name_name="GMMeltArmorDebuffEffect" defaultAbilityName_name="GMMeltArmorDebuffEffect" showOnHUD="0" />
      <effect name_name="GMUndyingImmortalEffect" defaultAbilityName_name="GMUndyingImmortalEffect" iconType_name="GMUndying" showOnHUD="1" effectNameLocalisationKey_name="effect_undying_skill" />
      <effect name_name="GMUndyingCooldownEffect" defaultAbilityName_name="GMUndyingCooldownEffect" iconType_name="GMUndying" showOnHUD="1" effectNameLocalisationKey_name="effect_undying_cooldown" />
      <effect name_name="GMMutation5Effect" defaultAbilityName_name="GMMutation5Effect" iconType_name="icon_mutation5" showOnHUD="1" effectNameLocalisationKey_name="skill_name_mutation_5" />
      <effect name_name="GMMutationTriggerEffect" defaultAbilityName_name="GMMutationTriggerEffect" isPotionEffect="1" showOnHUD="0" onStartSound_name="gui_potion_activation" />
      <effect name_name="GMKaerMorhenSetBonusEffect" defaultAbilityName_name="GMKaerMorhenSetBonusEffect" showOnHUD="0" />
      <effect name_name="GMRuneword4Effect" defaultAbilityName_name="GMRuneword4Effect" iconType_name="icon_effect_runeword" showOnHUD="1" effectNameLocalisationKey_name="runeword04_name" />
      <effect name_name="GMRuneword11Effect" defaultAbilityName_name="GMRuneword11Effect" iconType_name="icon_effect_runeword" showOnHUD="1" effectNameLocalisationKey_name="runeword11_name" />
      <!-- ALCH-15: the Dimeritium bomb's effect (legacy's DimeritiumEffect; its abilities GMDimeritiumEffect_Level1 to 3 in items/gm_alch.xml) -->
      <effect name_name="GMDimeritiumEffect" iconType_name="GMDimeritium" showOnHUD="1" effectNameLocalisationKey_name="effect_dimeritium" />
    </effects>
    <effect_icons>
      <effect iconType_name="GMAardCooldown" path="icons/Skills/core/magic_1.png" />
      <effect iconType_name="GMIgniCooldown" path="icons/Skills/core/magic_2.png" />
      <effect iconType_name="GMYrdenCooldown" path="icons/Skills/core/magic_3.png" />
      <effect iconType_name="GMQuenCooldown" path="icons/Skills/core/magic_4.png" />
      <effect iconType_name="GMAxiiCooldown" path="icons/Skills/core/magic_5.png" />
      <effect iconType_name="GMWhirlCooldown" path="icons/Skills/Sword/sword_s1.png" />
      <effect iconType_name="GMRendCooldown" path="icons/Skills/Sword/sword_s2.png" />
      <effect iconType_name="GMUndying" path="icons/Skills/Sword/sword_s18.png" />
      <effect iconType_name="GMMeltArmorTimer" path="icons/Skills/Signs/magic_s8.png" />
      <effect iconType_name="GMDimeritium" path="icons/inventory/bombs/dwimeritium_bomb.png" />
    </effect_icons>
  </custom>
</redxml>
