<?xml version="1.0" encoding="UTF-8"?>
<!-- Ghost Mode: the mutations' data (MUT). The mutation abilities are Blood and Wine's (dlc\bob),
     so each is given whole with on_conflict="replace". -->
<redxml>
  <definitions>
    <abilities>
      <!-- MUT-02 Conductors of Magic: 30% of the drawn sword's base damage (vanilla 50%). -->
      <ability name="Mutation1" on_conflict="replace">
        <dmg_bonus_factor type="add" min="0.3"/>
      </ability>
      <!-- MUT-03 Magic Sensibilities: crit chance 5% + 40% and crit damage +25% + 187.5% of the
           sign's power bonus (vanilla 20% + 10% and 100% of the raw intensity). -->
      <ability name="Mutation2" on_conflict="replace">
        <crit_chance_factor type="add" min="0.05"/>
        <crit_chance_factor type="mult" min="0.40"/>
        <crit_damage_factor type="add" min="0.25"/>
        <crit_damage_factor type="mult" min="1.875"/>
      </ability>
      <!-- MUT-04 Piercing Cold: 30% freeze chance (x (1 - frost resistance), in script); not frozen,
           250 force damage scaled by sign intensity (vanilla 1500 added to the Aard hit). -->
      <ability name="Mutation6" on_conflict="replace">
        <full_freeze_chance type="mult" min="0.3" />
        <ForceDamage type="add" min="250" />
      </ability>
      <!-- MUT-07 Adrenaline Rush: +50% attack power and sign intensity per adrenaline point in the
           Rush, -50% per point gained in it during the Recovery (vanilla +30% per extra enemy, then
           -10% per enemy up to 7). -->
      <ability name="Mutation7Buff" on_conflict="replace">
        <attack_power type="mult" min="0.5"/>
        <spell_power type="mult" min="0.5"/>
      </ability>
      <ability name="Mutation7Debuff" on_conflict="replace">
        <attack_power type="mult" min="-0.5"/>
        <spell_power type="mult" min="-0.5"/>
      </ability>
      <!-- MUT-13 Metamorphosis: up to 3 free decoctions (5.x 5), each +10% to the chances of critical
           effects; vanilla's random decoction (cooldown, duration) is gone. -->
      <ability name="Mutation12" on_conflict="replace">
        <maxcap type="add" min="3" />
        <mut12bonus type="add" min="0.1" />
      </ability>
      <!-- MUT-06 Deadly Counter: a countered enemy at 15% health or less dies (vanilla: humans at 25%);
           +33.34% melee damage per adrenaline point against a countered enemy (vanilla +25% sword
           damage against monsters and counter-immune humans). -->
      <ability name="Mutation8" on_conflict="replace">
        <dmg_bonus type="mult" min="0.3334" />
        <hp_perc_trigger type="mult" min="0.15" />
      </ability>
      <!-- MUT-11 Cat Eyes: bolts' base damage x2 (mut9_damage), 25% more aiming slow motion with
           toxicity; the 15% health loss kept; the +150 bolt damage and the crit chance and damage gone. -->
      <ability name="Mutation9" on_conflict="replace">
        <mut9_damage type="mult" min="1" />
        <health_reduction type="mult" min="0.15" />
        <mut9_slowdown type="add" min="0.25" />
      </ability>
      <!-- MUT-08 Toxic Blood: toxicity decays 50% slower; the acid deals 1.5 damage per second per
           toxicity point for 5 s (vanilla: 3 s, 1% of the damage taken per toxicity point), and pauses
           the enemy's health regeneration (5.x's DoT attributes). AcidEffect is Blood and Wine's. -->
      <ability name="Mutation4">
        <toxicityRegenFactor type="add" min="0.5" />
      </ability>
      <!-- The enemy's stamina regeneration -10% while the acid runs (vanilla -20% and -2000 essence
           regeneration after a vampire's bite). Blood and Wine's; STAM-08's value. -->
      <ability name="Mutation4BloodDebuff" on_conflict="replace">
        <tags> "BlackBloodDebuff" </tags>
        <staminaRegen type="mult" always_random="false" min="-0.1" max="-0.1" />
      </ability>
      <ability name="AcidEffect" on_conflict="replace">
        <tags></tags>
        <duration type="add" min="5"/>
        <DirectDamage type="add" min="1.5" max="1.5" />
        <hp_regen_reduction_strength type="add" min="200" />
        <hp_regen_reduction_duration type="add" min="5" />
      </ability>
      <!-- MUT-09 Euphoria: while overdosed in combat, the overdose drain x (1 + 0.75 x toxicity / 100),
           added to sword and Sign base damage (in script); 5.x's +0.75% attack power and sign
           intensity per toxicity point (mutation10_stat_boost) gone. Blood and Wine's. -->
      <ability name="Mutation10Effect" on_conflict="replace">
        <duration type="add" min="-1"/>
        <mutation10_factor type="mult" min="0.75"/>
      </ability>
      <!-- MUT-05 Bloodbath: stacks of 0.5% attack power, max 500 (250%); per equipped skill 20 (sword
           path) or 10 (others); +40 per kill; -1 per 1% of max Vitality lost (vanilla +5% per sword
           hit, max 50 stacks). -->
      <ability name="Mutation3" on_conflict="replace">
        <attack_power type="mult" min="0.005" />
        <mutation3_maxcap type="add" min="500" />
        <mutation3_buff_rate_sword type="add" min="20" />
        <mutation3_buff_rate_other type="add" min="10" />
        <mutation3_buff_rate_kill type="add" min="40" />
        <mutation3_debuff_rate type="add" min="1" />
      </ability>
      <!-- MUT-10 Mutated Skin: a hit's damage spread over 5 s per adrenaline point, adrenaline drained by
           1 point per 5 s (vanilla -15% damage per adrenaline point). -->
      <ability name="Mutation5" on_conflict="replace">
        <mut5_duration_per_point type="add" min="5.0" />
      </ability>
      <!-- MUT-12 Life Leech: 40 shock damage in the shock wave and the end impulse (vanilla 40 force);
           6 s without 5.x's Vitality regeneration (the drain heals instead); 90 s cooldown (5.x 120). -->
      <ability name="Mutation11" on_conflict="replace">
        <health_prc type="add" min="0" />
        <ShockDamage type="add" min="40" />
      </ability>
      <ability name="Mutation11BuffEffect" on_conflict="replace">
        <duration type="add" min="6"/>
      </ability>
      <ability name="Mutation11DebuffEffect" on_conflict="replace">
        <duration type="add" min="90"/>
      </ability>
    </abilities>
  </definitions>
</redxml>
