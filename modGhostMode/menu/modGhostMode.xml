<?xml version="1.0" encoding="UTF-8"?>
<!-- Ghost Mode options (Options > Mods > Ghost Mode). Group and variable ids as in legacy Ghost Mode 4.1;
     only the options of features already ported are listed. Defaults: scripts/local/gm/options/gmOptions.ws. -->
<UserConfig>
	<Group id="GMScalingOptions" displayName="Mods.ghost_mode.gm_scaling_options">
		<!-- DIFF-04 (slice D5b): legacy's three presets -->
		<PresetsArray>
			<Preset id="0" displayName="gm_recommended">
				<Entry varId="GMScaling" value="3"/>
				<Entry varId="GMRandomScalingMinLevel" value="0"/>
				<Entry varId="GMRandomScalingMaxLevel" value="0"/>
				<Entry varId="GMNonlinearLevelup" value="false"/>
				<Entry varId="GMNonlinearLevelDelta" value="0"/>
				<Entry varId="GMNonlinearAbilitiesDelta" value="0"/>
				<Entry varId="GMNoAnimalUpscaling" value="false"/>
				<Entry varId="GMNoAddLevelsGuards" value="false"/>
				<Entry varId="GMHealthMultiplier" value="0"/>
				<Entry varId="GMDamageMultiplier" value="0"/>
				<Entry varId="GMBossHealthMultiplier" value="0"/>
				<Entry varId="GMBossDamageMultiplier" value="0"/>
			</Preset>
			<Preset id="1" displayName="gm_hardcore">
				<Entry varId="GMScaling" value="1"/>
				<Entry varId="GMRandomScalingMinLevel" value="0"/>
				<Entry varId="GMRandomScalingMaxLevel" value="0"/>
				<Entry varId="GMNonlinearLevelup" value="true"/>
				<Entry varId="GMNonlinearLevelDelta" value="10"/>
				<Entry varId="GMNonlinearAbilitiesDelta" value="5"/>
				<Entry varId="GMNoAnimalUpscaling" value="false"/>
				<Entry varId="GMNoAddLevelsGuards" value="false"/>
				<Entry varId="GMHealthMultiplier" value="0.5"/>
				<Entry varId="GMDamageMultiplier" value="0.5"/>
				<Entry varId="GMBossHealthMultiplier" value="0.5"/>
				<Entry varId="GMBossDamageMultiplier" value="0.5"/>
			</Preset>
			<Preset id="2" displayName="gm_turn_off">
				<Entry varId="GMScaling" value="0"/>
				<Entry varId="GMRandomScalingMinLevel" value="0"/>
				<Entry varId="GMRandomScalingMaxLevel" value="0"/>
				<Entry varId="GMNonlinearLevelup" value="false"/>
				<Entry varId="GMNonlinearLevelDelta" value="0"/>
				<Entry varId="GMNonlinearAbilitiesDelta" value="0"/>
				<Entry varId="GMNoAnimalUpscaling" value="false"/>
				<Entry varId="GMNoAddLevelsGuards" value="false"/>
				<Entry varId="GMHealthMultiplier" value="0"/>
				<Entry varId="GMDamageMultiplier" value="0"/>
				<Entry varId="GMBossHealthMultiplier" value="0"/>
				<Entry varId="GMBossDamageMultiplier" value="0"/>
			</Preset>
		</PresetsArray>
		<VisibleVars>
			<!-- DIFF-04 (slices D5a and D5b), legacy's order -->
			<Var id="Virtual_GMScaling" displayName="gm_enemies_scaling" displayType="OPTIONS">
				<OptionsArray>
					<Option id="0" displayName="gm_es_none">
						<Entry varId="GMScaling" value="0"/>
					</Option>
					<Option id="1" displayName="gm_es_upscale">
						<Entry varId="GMScaling" value="1"/>
					</Option>
					<Option id="2" displayName="gm_es_match">
						<Entry varId="GMScaling" value="2"/>
					</Option>
					<Option id="3" displayName="gm_es_soft">
						<Entry varId="GMScaling" value="3"/>
					</Option>
					<Option id="4" displayName="gm_es_random">
						<Entry varId="GMScaling" value="4"/>
					</Option>
					<Option id="5" displayName="gm_es_random_no_down">
						<Entry varId="GMScaling" value="5"/>
					</Option>
					<!-- DIFF-10 (owner, 2026-10-31): new, after legacy's six -->
					<Option id="6" displayName="gm_es_interpolated">
						<Entry varId="GMScaling" value="6"/>
					</Option>
				</OptionsArray>
			</Var>
			<Var id="GMRandomScalingMinLevel" displayName="gm_rnd_scaling_min_slider" displayType="SLIDER;-12;12;24"/>
			<Var id="GMRandomScalingMaxLevel" displayName="gm_rnd_scaling_max_slider" displayType="SLIDER;-12;12;24"/>
			<Var id="GMNonlinearLevelup" displayName="gm_nonlinear_levelup_toggle" displayType="TOGGLE"/>
			<Var id="GMNonlinearLevelDelta" displayName="gm_nonlinear_level_delta_slider" displayType="SLIDER;0;20;20"/>
			<Var id="GMNonlinearAbilitiesDelta" displayName="gm_nonlinear_abs_delta_slider" displayType="SLIDER;0;20;20"/>
			<Var id="GMNoAddLevelsGuards" displayName="gm_no_add_levels_guards" displayType="TOGGLE"/>
			<Var id="GMNoAnimalUpscaling" displayName="gm_no_animal_upscaling_toggle" displayType="TOGGLE"/>
			<Var id="GMHealthMultiplier" displayName="gm_health_multiplier" displayType="SLIDER;-1;5;60"/>
			<Var id="GMDamageMultiplier" displayName="gm_damage_multiplier" displayType="SLIDER;-1;5;60"/>
			<Var id="GMBossHealthMultiplier" displayName="gm_boss_health_multiplier" displayType="SLIDER;-1;5;60"/>
			<Var id="GMBossDamageMultiplier" displayName="gm_boss_damage_multiplier" displayType="SLIDER;-1;5;60"/>
			<!-- DIFF-09 (owner, 2026-10-31): new; caps the mode while Ciri is the player, never raises it; not in the presets -->
			<Var id="Virtual_GMCiriDifficulty" displayName="gm_ciri_difficulty" displayType="OPTIONS">
				<OptionsArray>
					<Option id="0" displayName="gm_ciri_diff_same">
						<Entry varId="GMCiriDifficulty" value="0"/>
					</Option>
					<Option id="1" displayName="gm_ciri_diff_medium">
						<Entry varId="GMCiriDifficulty" value="1"/>
					</Option>
					<Option id="2" displayName="gm_ciri_diff_easy">
						<Entry varId="GMCiriDifficulty" value="2"/>
					</Option>
				</OptionsArray>
			</Var>
		</VisibleVars>
	</Group>
	<Group id="GMExpOptions" displayName="Mods.ghost_mode.gm_exp_options">
		<!-- XP-07 (slice X4): legacy's group, its one preset and its four options -->
		<PresetsArray>
			<Preset id="0" displayName="gm_default">
				<Entry varId="GMNoQuestLevels" value="false"/>
				<Entry varId="GMUseXMLExp" value="false"/>
				<Entry varId="GMQuestExpModifier" value="0"/>
				<Entry varId="GMMonsterExpModifier" value="0"/>
			</Preset>
		</PresetsArray>
		<VisibleVars>
			<Var id="GMNoQuestLevels" displayName="gm_no_quest_levels_toggle" displayType="TOGGLE"/>
			<Var id="GMUseXMLExp" displayName="gm_use_xml_exp_toggle" displayType="TOGGLE"/>
			<Var id="GMQuestExpModifier" displayName="gm_quest_exp_slider" displayType="SLIDER;-1;1;200"/>
			<Var id="GMMonsterExpModifier" displayName="gm_monster_exp_slider" displayType="SLIDER;-1;1;200"/>
		</VisibleVars>
	</Group>
	<Group id="GMGameplayOptions" displayName="Mods.ghost_mode.gm_gameplay_options">
		<!-- OPT-07 (slice O2): legacy's three presets, without GMVersion (PO2) and without the port's skill tree toggle (PO8) -->
		<PresetsArray>
			<Preset id="0" displayName="gm_recommended">
				<Entry varId="GMSinkBoat" value="true"/>
				<Entry varId="GMSinkBoatOverEnc" value="20"/>
				<Entry varId="GMEncumbranceMultiplier" value="0"/>
				<Entry varId="GMArmorRegenPenalty" value="false"/>
				<Entry varId="GMCombatStaminaRegen" value="0"/>
				<Entry varId="GMOutOfCombatStaminaRegen" value="0"/>
				<Entry varId="GMCombatVitalityRegen" value="0"/>
				<Entry varId="GMOutOfCombatVitalityRegen" value="0"/>
				<Entry varId="GMAgilityStaminaCostMultiplier" value="0"/>
				<Entry varId="GMMeleeStaminaCostMultiplier" value="0"/>
				<Entry varId="GMSignStaminaCostMultiplier" value="0"/>
				<Entry varId="GMStaminaDelay" value="0"/>
				<Entry varId="GMMeleeSpecialCooldown" value="7.5"/>
				<Entry varId="GMSignCooldown" value="5"/>
				<Entry varId="GMAltSignCooldown" value="7.5"/>
				<Entry varId="GMExhaustion" value="true"/>
				<Entry varId="GMExhaustionMaxRegen" value="0.4"/>
				<Entry varId="GMExhaustionAdrenaline" value="0.03"/>
				<Entry varId="GMExhaustionFloor" value="40"/>
			</Preset>
			<Preset id="1" displayName="gm_old_ver">
				<Entry varId="GMSinkBoat" value="false"/>
				<Entry varId="GMSinkBoatOverEnc" value="0"/>
				<Entry varId="GMEncumbranceMultiplier" value="0"/>
				<Entry varId="GMArmorRegenPenalty" value="true"/>
				<Entry varId="GMCombatStaminaRegen" value="-5"/>
				<Entry varId="GMOutOfCombatStaminaRegen" value="0"/>
				<Entry varId="GMCombatVitalityRegen" value="1"/>
				<Entry varId="GMOutOfCombatVitalityRegen" value="1"/>
				<Entry varId="GMAgilityStaminaCostMultiplier" value="0"/>
				<Entry varId="GMMeleeStaminaCostMultiplier" value="-1"/>
				<Entry varId="GMSignStaminaCostMultiplier" value="1.5"/>
				<Entry varId="GMStaminaDelay" value="0"/>
				<Entry varId="GMMeleeSpecialCooldown" value="0"/>
				<Entry varId="GMSignCooldown" value="0"/>
				<Entry varId="GMAltSignCooldown" value="0"/>
				<Entry varId="GMExhaustion" value="false"/>
				<Entry varId="GMExhaustionMaxRegen" value="0.4"/>
				<Entry varId="GMExhaustionAdrenaline" value="0.03"/>
				<Entry varId="GMExhaustionFloor" value="40"/>
			</Preset>
			<Preset id="2" displayName="gm_turn_off">
				<Entry varId="GMSinkBoat" value="false"/>
				<Entry varId="GMSinkBoatOverEnc" value="0"/>
				<Entry varId="GMEncumbranceMultiplier" value="0"/>
				<Entry varId="GMArmorRegenPenalty" value="false"/>
				<Entry varId="GMCombatStaminaRegen" value="0"/>
				<Entry varId="GMOutOfCombatStaminaRegen" value="0"/>
				<Entry varId="GMCombatVitalityRegen" value="0"/>
				<Entry varId="GMOutOfCombatVitalityRegen" value="0"/>
				<Entry varId="GMAgilityStaminaCostMultiplier" value="0"/>
				<Entry varId="GMMeleeStaminaCostMultiplier" value="0"/>
				<Entry varId="GMSignStaminaCostMultiplier" value="0"/>
				<Entry varId="GMStaminaDelay" value="0"/>
				<Entry varId="GMMeleeSpecialCooldown" value="0"/>
				<Entry varId="GMSignCooldown" value="0"/>
				<Entry varId="GMAltSignCooldown" value="0"/>
				<Entry varId="GMExhaustion" value="false"/>
				<Entry varId="GMExhaustionMaxRegen" value="0.4"/>
				<Entry varId="GMExhaustionAdrenaline" value="0.03"/>
				<Entry varId="GMExhaustionFloor" value="40"/>
			</Preset>
		</PresetsArray>
		<VisibleVars>
			<!-- SKL-02 -->
			<Var id="GMClassicSkillTree" displayName="gm_classic_skill_tree" displayType="TOGGLE"/>
			<!-- OPT-04 (OPT slice O0, legacy's entries; the mechanics are WGT's, WGT-10): boat sinking, on at 20% (DO3) -->
			<Var id="GMSinkBoat" displayName="gm_sink_boat_toggle" displayType="TOGGLE"/>
			<Var id="GMSinkBoatOverEnc" displayName="gm_sink_boat_slider" displayType="SLIDER;0;100;100"/>
			<!-- OPT-05 (OPT slice O0, legacy's entry; the mechanics are WGT's, WGT-02): item weight reduction -->
			<Var id="GMEncumbranceMultiplier" displayName="gm_encumbrance_slider" displayType="SLIDER;0;100;100"/>
			<!-- STAM-05 -->
			<Var id="GMArmorRegenPenalty" displayName="gm_armor_reg_penalty" displayType="TOGGLE"/>
			<!-- STAM-04 -->
			<Var id="GMCombatStaminaRegen" displayName="gm_cbtsreg" displayType="SLIDER;-15;85;100"/>
			<Var id="GMOutOfCombatStaminaRegen" displayName="gm_ocbtsreg" displayType="SLIDER;-100;0;100"/>
			<!-- OPT-03 (slice O1): Vitality regen per second added in and out of combat -->
			<Var id="GMCombatVitalityRegen" displayName="gm_cbtvreg" displayType="SLIDER;0;1000;1000"/>
			<Var id="GMOutOfCombatVitalityRegen" displayName="gm_ocbtvreg" displayType="SLIDER;0;1000;1000"/>
			<!-- STAM-03 -->
			<Var id="GMAgilityStaminaCostMultiplier" displayName="gm_ascost" displayType="SLIDER;-1;5;60"/>
			<Var id="GMMeleeStaminaCostMultiplier" displayName="gm_mscost" displayType="SLIDER;-1;5;60"/>
			<Var id="GMSignStaminaCostMultiplier" displayName="gm_sscost" displayType="SLIDER;-1;3;40"/>
			<!-- STAM-06 -->
			<Var id="GMStaminaDelay" displayName="gm_stdelay" displayType="SLIDER;-1;5;60"/>
			<!-- STAM-02 (legacy's order since OPT slice O2, PO3) -->
			<Var id="GMMeleeSpecialCooldown" displayName="gm_mcooldown" displayType="SLIDER;0;30;60"/>
			<!-- STAM-01 -->
			<Var id="GMSignCooldown" displayName="gm_scooldown" displayType="SLIDER;0;30;60"/>
			<Var id="GMAltSignCooldown" displayName="gm_ascooldown" displayType="SLIDER;0;30;60"/>
			<!-- STAM-10 (new skill tree only; the menu cannot hide options per tree, so the labels say it) -->
			<Var id="GMExhaustion" displayName="gm_exhaustion" displayType="TOGGLE"/>
			<Var id="GMExhaustionMaxRegen" displayName="gm_exh_maxregen" displayType="SLIDER;0;1;20"/>
			<Var id="GMExhaustionAdrenaline" displayName="gm_exh_adrenaline" displayType="SLIDER;0;0.1;20"/>
			<Var id="GMExhaustionFloor" displayName="gm_exh_floor" displayType="SLIDER;10;100;18"/>
		</VisibleVars>
	</Group>
	<Group id="GMQOLOptions" displayName="Mods.ghost_mode.gm_qol_options">
		<!-- OPT-07 (slice O2): legacy's two presets, without GMSignInstantCast (DO5: 5.x's "Quick Sign Casting" instead) -->
		<PresetsArray>
			<Preset id="0" displayName="gm_recommended">
				<Entry varId="GMLowStaminaSFX" value="50"/>
				<Entry varId="GMLowStaminaSFXVolume" value="100"/>
				<Entry varId="GMLowStaminaSFXDynamicVolume" value="true"/>
				<Entry varId="GMLowStaminaSFXRate" value="0"/>
				<Entry varId="GMLowStaminaSFXDynamicRate" value="true"/>
			</Preset>
			<Preset id="1" displayName="gm_turn_off">
				<Entry varId="GMLowStaminaSFX" value="0"/>
				<Entry varId="GMLowStaminaSFXVolume" value="0"/>
				<Entry varId="GMLowStaminaSFXDynamicVolume" value="false"/>
				<Entry varId="GMLowStaminaSFXRate" value="0"/>
				<Entry varId="GMLowStaminaSFXDynamicRate" value="false"/>
			</Preset>
		</PresetsArray>
		<VisibleVars>
			<!-- STAM-07 -->
			<Var id="GMLowStaminaSFX" displayName="gm_lowstamsfx" displayType="SLIDER;0;100;100"/>
			<Var id="GMLowStaminaSFXVolume" displayName="gm_lowstamsfx_vol" displayType="SLIDER;0;100;100"/>
			<Var id="GMLowStaminaSFXDynamicVolume" displayName="gm_lowstamsfx_dynvol" displayType="TOGGLE"/>
			<Var id="GMLowStaminaSFXRate" displayName="gm_lowstamsfx_rate" displayType="SLIDER;0;100;100"/>
			<Var id="GMLowStaminaSFXDynamicRate" displayName="gm_lowstamsfx_dynrate" displayType="TOGGLE"/>
		</VisibleVars>
	</Group>
</UserConfig>
